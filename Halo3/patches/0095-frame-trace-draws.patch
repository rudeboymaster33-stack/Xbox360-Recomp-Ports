From 6d705fc0952485488e83a0c8a72b20fa2f460067 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Sat, 24 Oct 2026 10:22:18 -0400
Subject: [PATCH] gpu_frame_trace_draws: per-draw shaders, blend/RT state and
 texture details in the frame trace

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01JJM25S15YdvewrFFwP8g6Z
---
 src/graphics/vulkan/command_processor.cpp | 30 +++++++++++++++++++++++
 1 file changed, 30 insertions(+)

diff --git a/src/graphics/vulkan/command_processor.cpp b/src/graphics/vulkan/command_processor.cpp
index 476982b..f0da6ac 100644
--- a/src/graphics/vulkan/command_processor.cpp
+++ b/src/graphics/vulkan/command_processor.cpp
@@ -118,6 +118,9 @@ REXCVAR_DEFINE_BOOL(gpu_debug_fault_watch, false, "GPU",
 REXCVAR_DEFINE_BOOL(gpu_frame_trace, true, "GPU",
                     "With vulkan_gpu_timestamps, also write the detailed [gpu-dt] trace of one "
                     "frame every 120 frames (very verbose)");
+REXCVAR_DEFINE_BOOL(gpu_frame_trace_draws, false, "GPU",
+                    "With the [gpu-dt] frame trace, also log every draw with its shaders, blend "
+                    "and render target state, and textures (format, size, clamp, border)");
 REXCVAR_DEFINE_BOOL(vulkan_gpu_timestamps, false, "GPU",
                     "Profile GPU time per category (passes, transfers, outside-pass work) "
                     "with timestamp queries and log [gpu-time] lines");
@@ -5243,6 +5246,33 @@ bool VulkanCommandProcessor::IssueDraw(xenos::PrimitiveType prim_type, uint32_t
                                      regs[XE_GPU_REG_RB_BLENDCONTROL0],
                                      regs[XE_GPU_REG_PA_CL_VTE_CNTL],
                                      regs[XE_GPU_REG_PA_SU_SC_MODE_CNTL]));
+    if (REXCVAR_GET(gpu_frame_trace_draws)) {
+      std::string tex_text;
+      uint32_t tmask = used_texture_mask;
+      while (tmask) {
+        uint32_t ti = uint32_t(__builtin_ctz(tmask));
+        tmask &= tmask - 1;
+        xenos::xe_gpu_texture_fetch_t f = regs.GetTextureFetch(ti);
+        tex_text += fmt::format(
+            " t{}={:08X}/fmt{}/{}x{}/clamp{}{}{}/border{}/sw{:03X}/sign{}{}{}{}/filt{}{}", ti,
+            uint32_t(f.base_address) << 12, uint32_t(f.format), uint32_t(f.size_2d.width) + 1,
+            uint32_t(f.size_2d.height) + 1, uint32_t(f.clamp_x), uint32_t(f.clamp_y),
+            uint32_t(f.clamp_z), uint32_t(f.border_color), uint32_t(f.swizzle),
+            uint32_t(f.sign_x), uint32_t(f.sign_y), uint32_t(f.sign_z), uint32_t(f.sign_w),
+            uint32_t(f.min_filter), uint32_t(f.mag_filter));
+      }
+      REXGPU_INFO(
+          "[gpu-draw] vs={:016X} ps={:016X} prim={} n={} blend0={:08X} colorctl={:08X} "
+          "depthctl={:08X} colorinfo0={:08X} surface={:08X} colormask={:08X} modecntl={:08X} "
+          "alpharef={:08X} kill={}{}",
+          vertex_shader->ucode_data_hash(), pixel_shader ? pixel_shader->ucode_data_hash() : 0,
+          uint32_t(prim_type), index_count, regs[XE_GPU_REG_RB_BLENDCONTROL0],
+          regs[XE_GPU_REG_RB_COLORCONTROL], regs[XE_GPU_REG_RB_DEPTHCONTROL],
+          regs[XE_GPU_REG_RB_COLOR_INFO], regs[XE_GPU_REG_RB_SURFACE_INFO],
+          regs[XE_GPU_REG_RB_COLOR_MASK], regs[XE_GPU_REG_RB_MODECONTROL],
+          regs[XE_GPU_REG_RB_ALPHA_REF], pixel_shader ? int(pixel_shader->kills_pixels()) : 0,
+          tex_text);
+    }
     uint32_t dmask = used_texture_mask;
     while (dmask) {
       uint32_t ti = uint32_t(__builtin_ctz(dmask));
-- 
2.43.0

