From ea8f15b384a788a3eecbe6fad6c9fe98b9ba83f3 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Sat, 24 Oct 2026 16:59:21 -0400
Subject: [PATCH] Audio: stereo output peak limiter (audio_limiter),
 [audio-stats] underrun/peak log, raised priority for the audio and XMA worker
 threads

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01JJM25S15YdvewrFFwP8g6Z
---
 src/audio/audio_system.cpp         |  7 +++
 src/audio/sdl/sdl_audio_driver.cpp | 74 +++++++++++++++++++++++++++++-
 src/audio/xma_decoder.cpp          |  7 +++
 3 files changed, 86 insertions(+), 2 deletions(-)

diff --git a/src/audio/audio_system.cpp b/src/audio/audio_system.cpp
index 7a711a8..3b52f35 100644
--- a/src/audio/audio_system.cpp
+++ b/src/audio/audio_system.cpp
@@ -9,6 +9,9 @@
  * @modified    Tom Clay, 2026 - Adapted for ReXGlue runtime
  */
 
+#if !defined(_WIN32)
+#include <sys/resource.h>
+#endif
 #include <rex/assert.h>
 #include <rex/audio/audio_driver.h>
 #include <rex/audio/audio_system.h>
@@ -98,6 +101,10 @@ X_STATUS AudioSystem::Setup(system::KernelState* kernel_state) {
 
 void AudioSystem::WorkerThreadMain() {
   // Initialize driver and ringbuffer.
+#if !defined(_WIN32)
+  // Audio work is small but must never wait behind game threads (underruns).
+  setpriority(PRIO_PROCESS, 0, -16);
+#endif
   Initialize();
 
   // Main run loop.
diff --git a/src/audio/sdl/sdl_audio_driver.cpp b/src/audio/sdl/sdl_audio_driver.cpp
index 3420f55..3bd04de 100644
--- a/src/audio/sdl/sdl_audio_driver.cpp
+++ b/src/audio/sdl/sdl_audio_driver.cpp
@@ -10,6 +10,7 @@
  */
 
 #include <algorithm>
+#include <cmath>
 #include <array>
 #include <cstring>
 
@@ -25,6 +26,23 @@
 #include <SDL3/SDL.h>
 
 REXCVAR_DEFINE_BOOL(audio_mute, false, "Audio", "Mute audio output");
+REXCVAR_DEFINE_BOOL(audio_limiter, true, "Audio",
+                    "Stereo output: smoothly lower the volume of peaks that would go past full "
+                    "scale (loud explosions) instead of hard clipping them");
+REXCVAR_DEFINE_BOOL(audio_stats, true, "Audio",
+                    "Log [audio-stats] every ~5 s: buffer underruns and peak levels");
+
+namespace {
+// Output stage state (one device): limiter gain and statistics.
+float g_limiter_gain = 1.0f;
+uint32_t g_stat_callbacks = 0;
+uint32_t g_stat_underruns = 0;
+uint32_t g_stat_frames = 0;
+uint32_t g_stat_clipped_frames = 0;
+float g_stat_peak = 0.0f;
+float g_stat_min_gain = 1.0f;
+bool g_had_audio = false;
+}  // namespace
 
 namespace rex::audio::sdl {
 
@@ -190,6 +208,9 @@ void SDLAudioDriver::SDLCallback(void* userdata, SDL_AudioStream* stream, int ad
     static uint32_t sdl_callback_count = 0;
     std::unique_lock<std::mutex> guard(driver->frames_mutex_);
     if (driver->frames_queued_.empty()) {
+      if (g_had_audio) {
+        ++g_stat_underruns;
+      }
       if (sdl_callback_count < 10) {
         REXAPU_DEBUG("SDLCallback: no frames queued (silence)");
         sdl_callback_count++;
@@ -208,8 +229,46 @@ void SDLAudioDriver::SDLCallback(void* userdata, SDL_AudioStream* stream, int ad
       } else {
         switch (driver->sdl_device_channels_) {
           case 2:
-            conversion::sequential_6_BE_to_interleaved_2_LE(data, buffer, channel_samples_, fold,
-                                                            gain);
+            if (REXCVAR_GET(audio_limiter) || REXCVAR_GET(audio_stats)) {
+              // Fold 5.1 to stereo, then a peak limiter: instant attack, ~150 ms
+              // release, ceiling slightly below full scale.
+              const bool limit = REXCVAR_GET(audio_limiter);
+              const float ceiling = 0.97f;
+              const float release = 1.0f / (0.15f * float(frame_frequency_));
+              const float scale = fold.scale * gain;
+              float frame_peak = 0.0f;
+              float limiter_gain = g_limiter_gain;
+              for (uint32_t i = 0; i < channel_samples_; ++i) {
+                const float fl = rex::byte_swap(buffer[0 * channel_samples_ + i]);
+                const float fr = rex::byte_swap(buffer[1 * channel_samples_ + i]);
+                const float fc = rex::byte_swap(buffer[2 * channel_samples_ + i]);
+                const float lf = rex::byte_swap(buffer[3 * channel_samples_ + i]);
+                const float bl = rex::byte_swap(buffer[4 * channel_samples_ + i]);
+                const float br = rex::byte_swap(buffer[5 * channel_samples_ + i]);
+                const float mid = fc * fold.center + lf * fold.lfe;
+                float left = (fl + mid + bl * fold.surround) * scale;
+                float right = (fr + mid + br * fold.surround) * scale;
+                const float peak = std::max(std::abs(left), std::abs(right));
+                frame_peak = std::max(frame_peak, peak);
+                if (limit) {
+                  if (peak * limiter_gain > ceiling) {
+                    limiter_gain = ceiling / peak;
+                  }
+                  left *= limiter_gain;
+                  right *= limiter_gain;
+                  limiter_gain = std::min(1.0f, limiter_gain + (1.0f - limiter_gain) * release);
+                }
+                data[i * 2] = std::clamp(left, -1.0f, 1.0f);
+                data[i * 2 + 1] = std::clamp(right, -1.0f, 1.0f);
+              }
+              g_limiter_gain = limiter_gain;
+              g_stat_peak = std::max(g_stat_peak, frame_peak);
+              g_stat_min_gain = std::min(g_stat_min_gain, limiter_gain);
+              g_stat_clipped_frames += frame_peak > 1.0f;
+            } else {
+              conversion::sequential_6_BE_to_interleaved_2_LE(data, buffer, channel_samples_, fold,
+                                                              gain);
+            }
             break;
           case 6:
             conversion::sequential_6_BE_to_interleaved_6_LE(data, buffer, channel_samples_, mix,
@@ -226,6 +285,8 @@ void SDLAudioDriver::SDLCallback(void* userdata, SDL_AudioStream* stream, int ad
         break;
       }
       driver->frames_unused_.push(buffer);
+      g_had_audio = true;
+      ++g_stat_frames;
 
       auto ret = driver->semaphore_->Release(1, nullptr);
       assert_true(ret);
@@ -233,6 +294,15 @@ void SDLAudioDriver::SDLCallback(void* userdata, SDL_AudioStream* stream, int ad
     }
   }
   SDL_stack_free(data);
+  if (REXCVAR_GET(audio_stats) && ++g_stat_callbacks >= 1000) {
+    REXAPU_INFO("[audio-stats] frames={} underruns={} frames_over_full_scale={} peak={:.2f} "
+                "limiter_min_gain={:.2f} queued_now={}",
+                g_stat_frames, g_stat_underruns, g_stat_clipped_frames, g_stat_peak,
+                g_stat_min_gain, driver->frames_queued_.size());
+    g_stat_callbacks = g_stat_underruns = g_stat_frames = g_stat_clipped_frames = 0;
+    g_stat_peak = 0.0f;
+    g_stat_min_gain = 1.0f;
+  }
 }
 
 }  // namespace rex::audio::sdl
