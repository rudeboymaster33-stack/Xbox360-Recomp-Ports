From 39992da85ef05fa4ce57a1a01343eb26c9f3b399 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Sat, 24 Oct 2026 09:34:19 -0400
Subject: [PATCH] Android: keep emulator and game threads on the fast CPU cores
 (android_fast_cores_only)

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01JJM25S15YdvewrFFwP8g6Z
---
 include/rex/thread.h             |  5 +++
 src/core/threading_posix.cpp     | 65 ++++++++++++++++++++++++++++++++
 src/ui/windowed_app_main_sdl.cpp |  2 +
 3 files changed, 72 insertions(+)

diff --git a/include/rex/thread.h b/include/rex/thread.h
index 7026431..b8feace 100644
--- a/include/rex/thread.h
+++ b/include/rex/thread.h
@@ -105,6 +105,11 @@ void set_current_thread_id(uint32_t id);
 // Sets the current thread name.
 void set_current_thread_name(const std::string_view name);
 
+// Android: restricts the calling thread to the fast CPU cores (no-op elsewhere
+// or with --android_fast_cores_only=false). Threads created through rex are
+// restricted automatically.
+void PinCurrentThreadToFastCores();
+
 // Yields the current thread to the scheduler. Maybe.
 void MaybeYield();
 
diff --git a/src/core/threading_posix.cpp b/src/core/threading_posix.cpp
index 29ba4e1..e4bbdc9 100644
--- a/src/core/threading_posix.cpp
+++ b/src/core/threading_posix.cpp
@@ -36,6 +36,7 @@ static_assert(REX_PLATFORM_LINUX || REX_PLATFORM_MAC, "This file is POSIX-only")
 #include <unistd.h>
 
 #include <rex/assert.h>
+#include <rex/cvar.h>
 #include <rex/chrono/chrono_steady_cast.h>
 #include <rex/logging.h>
 #include <rex/thread/timer_queue.h>
@@ -62,6 +63,10 @@ static_assert(REX_PLATFORM_LINUX || REX_PLATFORM_MAC, "This file is POSIX-only")
 #define REX_HAS_SIGEV_THREAD_ID 0
 #endif
 
+REXCVAR_DEFINE_BOOL(android_fast_cores_only, true, "Kernel",
+                    "Android: run emulator and game threads only on the fast (big/prime) "
+                    "CPU cores");
+
 namespace rex::thread {
 
 #if REX_PLATFORM_ANDROID
@@ -1412,6 +1417,57 @@ class PosixThread : public PosixConditionHandle<Thread> {
 
 thread_local PosixThread* current_thread_ = nullptr;
 
+#if REX_PLATFORM_ANDROID
+// Phones mix fast and slow (efficiency) cores. Left alone, the scheduler puts
+// threads that look lightly loaded - like a game's main thread waiting for
+// vsync between bursts of work - on the slow cores, where a frame's work can
+// take several times longer and miss its deadline.
+static void PinCurrentThreadToFastCoresImpl() {
+  if (!REXCVAR_GET(android_fast_cores_only)) {
+    return;
+  }
+  static const uint64_t fast_mask = []() -> uint64_t {
+    uint32_t max_freq[64] = {};
+    uint32_t highest = 0;
+    long cpu_count = std::min<long>(sysconf(_SC_NPROCESSORS_CONF), 64);
+    for (long i = 0; i < cpu_count; ++i) {
+      char path[96];
+      std::snprintf(path, sizeof(path), "/sys/devices/system/cpu/cpu%ld/cpufreq/cpuinfo_max_freq",
+                    i);
+      if (FILE* f = std::fopen(path, "r")) {
+        unsigned int khz = 0;
+        if (std::fscanf(f, "%u", &khz) == 1) {
+          max_freq[i] = khz;
+          highest = std::max(highest, khz);
+        }
+        std::fclose(f);
+      }
+    }
+    uint64_t mask = 0;
+    for (long i = 0; i < cpu_count; ++i) {
+      // Big and prime cores (e.g. 2.8 and 3.2 GHz), not the ~2 GHz little ones.
+      if (highest && max_freq[i] >= highest * 4 / 5) {
+        mask |= uint64_t(1) << i;
+      }
+    }
+    REXLOG_INFO("Pinning threads to fast CPU cores: mask {:#x} (fastest {} MHz)", mask,
+                highest / 1000);
+    return mask;
+  }();
+  if (!fast_mask) {
+    return;
+  }
+  cpu_set_t cpu_set;
+  CPU_ZERO(&cpu_set);
+  for (uint32_t i = 0; i < 64; ++i) {
+    if (fast_mask & (uint64_t(1) << i)) {
+      CPU_SET(i, &cpu_set);
+    }
+  }
+  sched_setaffinity(0, sizeof(cpu_set), &cpu_set);
+}
+#endif
+
 void* PosixCondition<Thread>::ThreadStartRoutine(void* parameter) {
 #if !REX_PLATFORM_ANDROID
   if (pthread_setcanceltype(PTHREAD_CANCEL_ASYNCHRONOUS, nullptr) != 0) {
@@ -1419,6 +1475,9 @@ void* PosixCondition<Thread>::ThreadStartRoutine(void* parameter) {
   }
 #endif
   set_current_thread_name("");
+#if REX_PLATFORM_ANDROID
+  PinCurrentThreadToFastCoresImpl();
+#endif
 
   auto start_data = static_cast<ThreadStartData*>(parameter);
   assert_not_null(start_data);
@@ -1522,6 +1581,12 @@ void Thread::Exit(int exit_code) {
   assert_always();
 }
 
+void PinCurrentThreadToFastCores() {
+#if REX_PLATFORM_ANDROID
+  PinCurrentThreadToFastCoresImpl();
+#endif
+}
+
 void set_current_thread_name(const std::string_view name) {
 #if defined(__APPLE__)
   pthread_setname_np(std::string(name).c_str());
diff --git a/src/ui/windowed_app_main_sdl.cpp b/src/ui/windowed_app_main_sdl.cpp
index 43d9c28..317126c 100644
--- a/src/ui/windowed_app_main_sdl.cpp
+++ b/src/ui/windowed_app_main_sdl.cpp
@@ -25,6 +25,7 @@
 #if REX_PLATFORM_ANDROID
 // Renames main() to SDL_main(), which SDL's Java activity calls.
 #include <SDL3/SDL_main.h>
+#include <rex/thread.h>
 #endif
 
 #if REX_PLATFORM_WIN32
@@ -45,6 +46,7 @@ int RunWindowedApp(int argc, char** argv) {
   auto remaining = rex::cvar::Init(argc, argv);
   rex::cvar::ApplyEnvironment();
   rex::InitLoggingEarly();
+  rex::thread::PinCurrentThreadToFastCores();
 
   int result;
   {
