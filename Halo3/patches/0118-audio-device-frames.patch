From ebdb9e40b253aa983286f9eb4e50515f53727299 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Sat, 24 Oct 2026 17:04:46 -0400
Subject: [PATCH] Audio: device callback size 256 samples
 (audio_device_sample_frames) so the game's 8-frame queue isn't drained 4
 frames at a time

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01JJM25S15YdvewrFFwP8g6Z
---
 src/audio/sdl/sdl_audio_driver.cpp | 8 ++++++++
 1 file changed, 8 insertions(+)

diff --git a/src/audio/sdl/sdl_audio_driver.cpp b/src/audio/sdl/sdl_audio_driver.cpp
index 3bd04de..5376212 100644
--- a/src/audio/sdl/sdl_audio_driver.cpp
+++ b/src/audio/sdl/sdl_audio_driver.cpp
@@ -13,6 +13,7 @@
 #include <cmath>
 #include <array>
 #include <cstring>
+#include <string>
 
 #include <rex/assert.h>
 #include <rex/audio/conversion.h>
@@ -29,6 +30,9 @@ REXCVAR_DEFINE_BOOL(audio_mute, false, "Audio", "Mute audio output");
 REXCVAR_DEFINE_BOOL(audio_limiter, true, "Audio",
                     "Stereo output: smoothly lower the volume of peaks that would go past full "
                     "scale (loud explosions) instead of hard clipping them");
+REXCVAR_DEFINE_INT32(audio_device_sample_frames, 256, "Audio",
+                     "Samples the audio device asks for per callback (0 = SDL default, which "
+                     "took 4 game audio frames at once and left little buffer to the game)");
 REXCVAR_DEFINE_BOOL(audio_stats, true, "Audio",
                     "Log [audio-stats] every ~5 s: buffer underruns and peak levels");
 
@@ -57,6 +61,10 @@ SDLAudioDriver::~SDLAudioDriver() {
 bool SDLAudioDriver::Initialize() {
   // Set audio category for proper OS audio handling
   SDL_SetHint(SDL_HINT_AUDIO_CATEGORY, "playback");
+  if (REXCVAR_GET(audio_device_sample_frames) > 0) {
+    SDL_SetHint(SDL_HINT_AUDIO_DEVICE_SAMPLE_FRAMES,
+                std::to_string(REXCVAR_GET(audio_device_sample_frames)).c_str());
+  }
 
   // Set app name for audio device identification
   SDL_SetAppMetadataProperty(SDL_PROP_APP_METADATA_NAME_STRING, "rexglue");
-- 
