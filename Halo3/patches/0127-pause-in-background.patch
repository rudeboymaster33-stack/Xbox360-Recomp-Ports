From e9a3a348029c777d61bdc036277559041eac866c Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Sat, 24 Oct 2026 19:45:03 -0400
Subject: [PATCH] Android: hold the guest vblank while the app has no surface
 (backgrounded) - pauses the game (gpu_pause_in_background)

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01JJM25S15YdvewrFFwP8g6Z
---
 include/rex/ui/presenter.h       |  5 +++++
 src/graphics/graphics_system.cpp | 18 ++++++++++++++++++
 src/ui/presenter.cpp             |  2 ++
 3 files changed, 25 insertions(+)

diff --git a/include/rex/ui/presenter.h b/include/rex/ui/presenter.h
index c94c36e..8f37c3a 100644
--- a/include/rex/ui/presenter.h
+++ b/include/rex/ui/presenter.h
@@ -969,6 +969,11 @@ class Presenter {
   std::atomic<uint64_t> guest_output_publish_count_{0};
   // CLOCK_MONOTONIC ns of the last guest output publish (frame latency stats).
   std::atomic<uint64_t> guest_output_publish_time_ns_{0};
+  // Whether a surface is attached (readable from any thread).
+  std::atomic<bool> has_surface_{false};
+ public:
+  bool HasSurfaceFromAnyThread() const { return has_surface_.load(std::memory_order_acquire); }
+ private:
  public:
   uint64_t GetGuestOutputPublishTimeNs() const {
     return guest_output_publish_time_ns_.load(std::memory_order_acquire);
diff --git a/src/graphics/graphics_system.cpp b/src/graphics/graphics_system.cpp
index b1cadc5..743bc5f 100644
--- a/src/graphics/graphics_system.cpp
+++ b/src/graphics/graphics_system.cpp
@@ -26,6 +26,7 @@
 #include <utility>
 
 #include <rex/cvar.h>
+#include <rex/platform.h>
 #include <rex/graphics/command_processor.h>
 #include <rex/graphics/flags.h>
 #include <rex/kernel/xboxkrnl/video.h>
@@ -34,9 +35,13 @@
 #include <rex/system/kernel_state.h>
 #include <rex/system/xthread.h>
 #include <rex/ui/graphics_provider.h>
+#include <rex/ui/presenter.h>
 #include <rex/ui/window.h>
 #include <rex/ui/windowed_app_context.h>
 
+REXCVAR_DEFINE_BOOL(gpu_pause_in_background, true, "GPU",
+                    "Android: stop the guest vblank while the app is in the background, which "
+                    "pauses the game (it waits for vblank) and saves battery");
 REXCVAR_DEFINE_BOOL(gpu_vblank_precise, true, "GPU",
                     "Guest vblank timer sleeps until each vblank is due (absolute deadline, "
                     "raised thread priority) instead of polling every 1 ms, and logs "
@@ -189,6 +194,19 @@ X_STATUS GraphicsSystem::SetupGuestGpu(runtime::FunctionDispatcher* function_dis
               next_ns = uint64_t(now_ts.tv_sec) * 1000000000ull + uint64_t(now_ts.tv_nsec);
               continue;
             }
+#if REX_PLATFORM_ANDROID
+            if (REXCVAR_GET(gpu_pause_in_background) && presenter_ &&
+                !presenter_->HasSurfaceFromAnyThread()) {
+              // The app is in the background (no surface): hold the vblank, so
+              // the game, which paces itself on it, stops - instead of running
+              // at full speed with nothing on screen.
+              rex::thread::Sleep(std::chrono::milliseconds(20));
+              clock_gettime(CLOCK_MONOTONIC, &now_ts);
+              next_ns = uint64_t(now_ts.tv_sec) * 1000000000ull + uint64_t(now_ts.tv_nsec) +
+                        interval_ns;
+              continue;
+            }
+#endif
             timespec deadline_ts;
             deadline_ts.tv_sec = time_t(next_ns / 1000000000ull);
             deadline_ts.tv_nsec = long(next_ns % 1000000000ull);
diff --git a/src/ui/presenter.cpp b/src/ui/presenter.cpp
index da0bc7f..2a0c36c 100644
--- a/src/ui/presenter.cpp
+++ b/src/ui/presenter.cpp
@@ -338,6 +338,7 @@ void Presenter::SetWindowSurfaceFromUIThread(Window* new_window, Surface* new_su
     DisconnectPaintingFromSurfaceFromUIThread(
         SurfacePaintConnectionState::kUnconnectedRetryAtStateChange);
     surface_ = nullptr;
+    has_surface_.store(false, std::memory_order_release);
     UpdateSurfaceMonitorFromUIThread(true);
   }
 
@@ -368,6 +369,7 @@ void Presenter::SetWindowSurfaceFromUIThread(Window* new_window, Surface* new_su
   if (new_surface) {
     assert_true(paint_mode_ == PaintMode::kNone);
     surface_ = new_surface;
+    has_surface_.store(new_surface != nullptr, std::memory_order_release);
     UpdateSurfaceMonitorFromUIThread(true);
     assert_true(surface_paint_connection_state_ ==
                 SurfacePaintConnectionState::kUnconnectedRetryAtStateChange);
-- 
