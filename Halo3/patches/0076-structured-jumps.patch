-        case ucode::ControlFlowOpcode::kCondJmp:
+    ucode::UnpackControlFlowInstructions(ucode_dwords + i * 3, cfs.data() + i * 2);
+  }
+  // Classify the jumps.
+  for (uint32_t i = 0; i < cf_count; ++i) {
+    const ucode::ControlFlowInstruction& cf = cfs[i];
+    if (cf.opcode() == ucode::ControlFlowOpcode::kCondCall ||
+        cf.opcode() == ucode::ControlFlowOpcode::kReturn) {
+      return false;
+    }
+    if (cf.opcode() != ucode::ControlFlowOpcode::kCondJmp) {
+      continue;
+    }
+    uint32_t target = cf.cond_jmp.address();
+    if (target <= i || target > cf_count) {
+      return false;
+    }
+    if (structured_jumps_.count(i)) {
+      // Already the else separator of an if-else.
+      continue;
+    }
+    StructuredJump jump = {StructuredJumpKind::kIfSkip, target, 0};
+    if (!cf.cond_jmp.is_unconditional() && target >= 2 && target - 1 > i) {
+      const ucode::ControlFlowInstruction& separator = cfs[target - 1];
+      if (separator.opcode() == ucode::ControlFlowOpcode::kCondJmp &&
+          separator.cond_jmp.is_unconditional() && separator.cond_jmp.address() > target &&
+          separator.cond_jmp.address() <= cf_count) {
+        jump.kind = StructuredJumpKind::kIfElse;
+        jump.else_label = target;
+        jump.end = separator.cond_jmp.address();
+        structured_jumps_[target - 1] = {StructuredJumpKind::kElseSeparator, jump.end, target};
+      }
+    }
+    structured_jumps_[i] = jump;
+  }
+  // Check the nesting of loops and jump regions.
+  struct Region {
+    bool is_loop;
+    uint32_t end;
+    uint32_t else_label;
+    bool in_else;
+  };
+  std::vector<Region> stack;
+  uint32_t loop_depth = 0;
+  for (uint32_t i = 0; i <= cf_count; ++i) {
+    // Labels before the instruction.
+    while (!stack.empty()) {
+      Region& top = stack.back();
+      if (!top.is_loop && top.end == i) {
+        stack.pop_back();
+        continue;
+      }
+      if (!top.is_loop && top.else_label == i && !top.in_else) {
+        top.in_else = true;
+        continue;
+      }
+      break;
+    }
+    for (const Region& region : stack) {
+      if (!region.is_loop && (region.end <= i || (region.else_label == i && !region.in_else))) {
+        // A region ending here is not on top - improper nesting.
+        return false;
+      }
+    }
+    if (i == cf_count) {
+      break;
+    }
+    const ucode::ControlFlowInstruction& cf = cfs[i];
+    switch (cf.opcode()) {
+      case ucode::ControlFlowOpcode::kLoopStart: {
+        if (loop_depth >= 4) {
           return false;
-        case ucode::ControlFlowOpcode::kLoopStart:
-          if (loop_stack.size() >= 4) {
-            return false;
-          }
-          loop_stack.emplace_back(cf_index, cf.loop_start.address());
-          break;
-        case ucode::ControlFlowOpcode::kLoopEnd: {
-          if (loop_stack.empty()) {
-            return false;
-          }
-          auto loop = loop_stack.back();
-          loop_stack.pop_back();
-          if (cf.loop_end.address() != loop.first + 1 || loop.second != cf_index + 1) {
-            return false;
-          }
-          loop_labels.insert(loop.first + 1);
-          loop_labels.insert(cf_index + 1);
-        } break;
-        default:
-          if (ucode::IsControlFlowOpcodeExec(cf.opcode()) &&
-              ucode::DoesControlFlowOpcodeEndShader(cf.opcode()) && !loop_stack.empty()) {
+        }
+        uint32_t skip = cf.loop_start.address();
+        // The loop end must be at skip - 1, jumping back to i + 1.
+        if (skip < i + 2 || skip > cf_count ||
+            cfs[skip - 1].opcode() != ucode::ControlFlowOpcode::kLoopEnd ||
+            cfs[skip - 1].loop_end.address() != i + 1) {
+          return false;
+        }
+        stack.push_back({true, skip - 1, 0, false});
+        ++loop_depth;
+      } break;
+      case ucode::ControlFlowOpcode::kLoopEnd:
+        if (stack.empty() || !stack.back().is_loop || stack.back().end != i) {
+          return false;
+        }
+        stack.pop_back();
+        --loop_depth;
+        break;
+      case ucode::ControlFlowOpcode::kCondJmp: {
+        auto it = structured_jumps_.find(i);
+        if (it == structured_jumps_.end()) {
+          return false;
+        }
+        const StructuredJump& jump = it->second;
+        if (jump.kind == StructuredJumpKind::kElseSeparator) {
+          if (stack.empty() || stack.back().is_loop || stack.back().in_else ||
+              stack.back().else_label != jump.else_label) {
             return false;
           }
-          break;
+        } else {
+          stack.push_back({false, jump.end,
+                           jump.kind == StructuredJumpKind::kIfElse ? jump.else_label : UINT32_MAX,
+                           false});
+        }
+      } break;
+      default:
+        if (ucode::IsControlFlowOpcodeExec(cf.opcode()) &&
+            ucode::DoesControlFlowOpcodeEndShader(cf.opcode()) && loop_depth) {
+          return false;
+        }
+        break;
+    }
+  }
+  return stack.empty();
+}
+
+void SpirvShaderTranslator::CloseStructuredRegionsAtLabel(uint32_t cf_index) {
+  while (!structured_region_stack_.empty()) {
+    StructuredRegion& top = structured_region_stack_.back();
+    if (top.kind == StructuredRegion::Kind::kLoop) {
+      break;
+    }
+    if (top.end == cf_index) {
+      if (!builder_->getBuildPoint()->isTerminated()) {
+        builder_->createBranch(top.merge);
+      }
+      if (top.kind == StructuredRegion::Kind::kIfElse && !top.in_else) {
+        // Empty else (shouldn't happen with a separator, but stay valid).
+        function_main_->addBlock(top.join);
+        builder_->setBuildPoint(top.join);
+        builder_->createBranch(top.merge);
       }
+      function_main_->addBlock(top.merge);
+      builder_->setBuildPoint(top.merge);
+      structured_region_stack_.pop_back();
+      continue;
+    }
+    if (top.kind == StructuredRegion::Kind::kIfElse && !top.in_else &&
+        top.else_label == cf_index) {
+      if (!builder_->getBuildPoint()->isTerminated()) {
+        builder_->createBranch(top.merge);
+      }
+      function_main_->addBlock(top.join);
+      builder_->setBuildPoint(top.join);
+      top.in_else = true;
+      continue;
     }
+    break;
   }
-  return loop_stack.empty() && loop_labels == shader.label_addresses();
 }
 
