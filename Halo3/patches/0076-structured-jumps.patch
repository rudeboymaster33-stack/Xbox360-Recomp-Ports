 void SpirvShaderTranslator::ProcessJumpInstruction(const ParsedJumpInstruction& instr) {
+  if (structured_loops_) {
+    CloseExecConditionals();
+    auto jump_it = structured_jumps_.find(structured_cf_index_);
+    assert_true(jump_it != structured_jumps_.end());
+    if (jump_it == structured_jumps_.end()) {
+      return;
+    }
+    const StructuredJump& jump = jump_it->second;
+    if (jump.kind == StructuredJumpKind::kElseSeparator) {
+      // End of the then part - go to the merge (the else label follows).
+      if (!structured_region_stack_.empty() && !builder_->getBuildPoint()->isTerminated()) {
+        builder_->createBranch(structured_region_stack_.back().merge);
+      }
+      return;
+    }
+    EnsureBuildPointAvailable();
+    spv::Id taken;
+    if (instr.type == ParsedJumpInstruction::Type::kConditional) {
+      id_vector_temp_.clear();
+      id_vector_temp_.push_back(const_int_0_);
+      id_vector_temp_.push_back(builder_->makeIntConstant(int(instr.bool_constant_index >> 7)));
+      id_vector_temp_.push_back(
+          builder_->makeIntConstant(int((instr.bool_constant_index >> 5) & 3)));
+      spv::Id bool_constant_scalar = builder_->createLoad(
+          builder_->createAccessChain(spv::StorageClassUniform, uniform_bool_loop_constants_,
+                                      id_vector_temp_),
+          spv::NoPrecision);
+      taken = builder_->createBinOp(
+          instr.condition ? spv::OpINotEqual : spv::OpIEqual, type_bool_,
+          builder_->createBinOp(
+              spv::OpBitwiseAnd, type_uint_, bool_constant_scalar,
+              builder_->makeUintConstant(uint32_t(1) << (instr.bool_constant_index & 31))),
+          const_uint_0_);
+    } else if (instr.type == ParsedJumpInstruction::Type::kPredicated) {
+      taken = builder_->createLoad(var_main_predicate_, spv::NoPrecision);
+      if (!instr.condition) {
+        taken = builder_->createUnaryOp(spv::OpLogicalNot, type_bool_, taken);
+      }
+    } else {
+      taken = builder_->makeBoolConstant(true);
+    }
+    StructuredRegion region = {};
+    region.merge = new spv::Block(builder_->getUniqueId(), *function_main_);
+    region.end = jump.end;
+    spv::Block& then_block = builder_->makeNewBlock();
+    builder_->createSelectionMerge(region.merge, spv::SelectionControlMaskNone);
+    if (jump.kind == StructuredJumpKind::kIfElse) {
+      region.kind = StructuredRegion::Kind::kIfElse;
+      region.else_label = jump.else_label;
+      region.join = new spv::Block(builder_->getUniqueId(), *function_main_);
+      builder_->createConditionalBranch(taken, region.join, &then_block);
+    } else {
+      region.kind = StructuredRegion::Kind::kIf;
+      region.else_label = UINT32_MAX;
+      builder_->createConditionalBranch(taken, region.merge, &then_block);
+    }
+    builder_->setBuildPoint(&then_block);
+    structured_region_stack_.push_back(region);
+    return;
+  }
   // Treat like exec, merge with execs if possible, since it's an if too.
   ParsedExecInstruction::Type type;
   if (instr.type == ParsedJumpInstruction::Type::kConditional) {
