+bool SpirvShaderTranslator::AnalyzeStructuredControlFlow() {
+  structured_jumps_.clear();
   const Shader& shader = current_shader();
   const uint32_t* ucode_dwords = shader.ucode_data().data();
   uint32_t cf_pair_index_bound = shader.cf_pair_index_bound();
-  // (loop start index, skip address).
-  std::vector<std::pair<uint32_t, uint32_t>> loop_stack;
-  std::set<uint32_t> loop_labels;
+  uint32_t cf_count = cf_pair_index_bound * 2;
+  std::vector<ucode::ControlFlowInstruction> cfs(cf_count);
   for (uint32_t i = 0; i < cf_pair_index_bound; ++i) {
-    ucode::ControlFlowInstruction cf_ab[2];
-    ucode::UnpackControlFlowInstructions(ucode_dwords + i * 3, cf_ab);
-    for (uint32_t j = 0; j < 2; ++j) {
