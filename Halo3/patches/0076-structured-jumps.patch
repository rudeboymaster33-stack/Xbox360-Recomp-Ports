-  bool IsStructuredLoopsEligible() const;
+  // gpu_shader_structured_loops: shaders whose control flow is properly nested
+  // guest loops and forward jumps (if / if-else shapes) are translated to
+  // structured SPIR-V loops and selections instead of a program counter switch
+  // inside the main loop.
+  enum class StructuredJumpKind {
+    // Jump forward over a range: if (!taken) { range }.
+    kIfSkip,
+    // Conditional jump to an else label preceded by an unconditional jump to
+    // the end: if (!taken) { then } else { else }.
+    kIfElse,
+    // The unconditional jump ending the then part of a kIfElse.
+    kElseSeparator,
+  };
+  struct StructuredJump {
+    StructuredJumpKind kind;
+    uint32_t end;
+    uint32_t else_label;
+  };
+  bool AnalyzeStructuredControlFlow();
+  uint32_t structured_cf_index_ = 0;
+  void ProcessControlFlowInstructionBegin(uint32_t cf_index) override {
+    structured_cf_index_ = cf_index;
+  }
+  void CloseStructuredRegionsAtLabel(uint32_t cf_index);
   bool use_main_switch_ = false;
   bool structured_loops_ = false;
-  struct StructuredLoop {
+  std::unordered_map<uint32_t, StructuredJump> structured_jumps_;
+  struct StructuredRegion {
+    enum class Kind { kLoop, kIf, kIfElse } kind;
+    // For loops.
     spv::Block* header;
-    spv::Block* merge;
     spv::Block* continue_target;
+    // Loop: the loop merge. If / if-else: the selection merge.
+    spv::Block* merge;
+    // Loop: the block after the loop (also the skip target). If-else: the else
+    // block.
     spv::Block* join;
+    // If: the label closing the region. If-else: the end label.
+    uint32_t end;
+    uint32_t else_label;
+    bool in_else;
   };
-  std::vector<StructuredLoop> structured_loop_stack_;
+  std::vector<StructuredRegion> structured_region_stack_;
 
   // If the exec bool constant / predicate conditional is open, block after it
   // (not added to the function yet).
