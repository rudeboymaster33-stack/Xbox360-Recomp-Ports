From 3b0e76177f84848b032643005832bd4a046ed7f4 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Sat, 24 Oct 2026 12:19:02 -0400
Subject: [PATCH] gpu_debug_cycle_draw_cost: cycle draw cost diagnostic modes
 on a wall-clock timer, with a start delay

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01JJM25S15YdvewrFFwP8g6Z
---
 src/graphics/vulkan/command_processor.cpp | 26 +++++++++++++++++++++--
 1 file changed, 24 insertions(+), 2 deletions(-)

diff --git a/src/graphics/vulkan/command_processor.cpp b/src/graphics/vulkan/command_processor.cpp
index aba366a..1d17a73 100644
--- a/src/graphics/vulkan/command_processor.cpp
+++ b/src/graphics/vulkan/command_processor.cpp
@@ -125,6 +125,11 @@ REXCVAR_DEFINE_INT32(gpu_debug_draw_cost, 0, "GPU",
                      "Diagnostic only (breaks visuals): 1 = 1x1 scissor on every draw, "
                      "2 = skip every guest draw, 3 = 1x1 scissor and at most 3 vertices "
                      "per draw (keeps only the fixed per-draw cost)");
+REXCVAR_DEFINE_BOOL(gpu_debug_cycle_draw_cost, false, "GPU",
+                    "Diagnostic only (breaks visuals): cycle gpu_debug_draw_cost through "
+                    "0, 1, 3, 2 every gpu_debug_cycle_seconds (wall clock), logging [gpu-cycle]");
+REXCVAR_DEFINE_INT32(gpu_debug_cycle_start_seconds, 0, "GPU",
+                     "Start gpu_debug_cycle_draw_cost this many seconds after the first draw");
 REXCVAR_DEFINE_BOOL(gpu_debug_special_draws, false, "GPU/Debug",
                     "Log (once per shader pair) draws that texture-fetch from a non-texture fetch "
                     "constant, tessellated draws, and memexport draws");
@@ -5564,7 +5569,24 @@ bool VulkanCommandProcessor::IssueDraw(xenos::PrimitiveType prim_type, uint32_t
   if (gpu_ts_cur_slot_) {
     gpu_ts_slot_verts_[gpu_ts_cur_slot_ - 1] += primitive_processing_result.host_draw_vertex_count;
   }
-  if (int32_t debug_draw_cost = REXCVAR_GET(gpu_debug_draw_cost)) {
+  int32_t debug_draw_cost_now = REXCVAR_GET(gpu_debug_draw_cost);
+  static const auto debug_cycle_first_draw = std::chrono::steady_clock::now();
+  if (REXCVAR_GET(gpu_debug_cycle_draw_cost) &&
+      std::chrono::steady_clock::now() - debug_cycle_first_draw >=
+          std::chrono::seconds(REXCVAR_GET(gpu_debug_cycle_start_seconds))) {
+    static const int32_t kCycleModes[] = {0, 1, 3, 2};
+    static int64_t cycle_last_slot = -1;
+    int64_t seconds = std::chrono::duration_cast<std::chrono::seconds>(
+                          std::chrono::system_clock::now().time_since_epoch())
+                          .count();
+    int64_t slot = seconds / std::max(REXCVAR_GET(gpu_debug_cycle_seconds), 1);
+    debug_draw_cost_now = kCycleModes[slot % 4];
+    if (slot != cycle_last_slot) {
+      cycle_last_slot = slot;
+      REXGPU_INFO("[gpu-cycle] draw_cost={}", debug_draw_cost_now);
+    }
+  }
+  if (int32_t debug_draw_cost = debug_draw_cost_now) {
     // Diagnostic: 1 = draw everything with a 1x1 scissor (keeps per-draw and
     // vertex work, removes pixel work), 2 = skip the host draws entirely.
     if (debug_draw_cost == 2) {
@@ -5585,7 +5607,7 @@ bool VulkanCommandProcessor::IssueDraw(xenos::PrimitiveType prim_type, uint32_t
     dynamic_scissor_update_needed_ = true;
   }
 
-  if (REXCVAR_GET(gpu_debug_draw_cost) == 3) {
+  if (debug_draw_cost_now == 3) {
     primitive_processing_result.host_draw_vertex_count =
         std::min(primitive_processing_result.host_draw_vertex_count, uint32_t(3));
   }
-- 
