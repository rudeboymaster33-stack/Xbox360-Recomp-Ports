diff --git a/include/rex/graphics/vulkan/pipeline_cache.h b/include/rex/graphics/vulkan/pipeline_cache.h
index af73e0c..ec3b8c7 100644
--- a/include/rex/graphics/vulkan/pipeline_cache.h
+++ b/include/rex/graphics/vulkan/pipeline_cache.h
@@ -380,6 +380,14 @@ class VulkanPipelineCache {
   // Destroys the least recently used pipelines above vulkan_pipeline_live_limit
   // (they are recreated on demand).
   void EvictPipelinesOverLimit();
+  // Driver pipeline cache (compiled shader binaries) kept in a file so later
+  // startups create the stored pipelines much faster.
+  void SaveVkPipelineCache(bool asynchronous);
+  VkPipelineCache vk_pipeline_cache_ = VK_NULL_HANDLE;
+  std::filesystem::path vk_pipeline_cache_path_;
+  std::atomic<uint32_t> vk_pipelines_created_since_save_{0};
+  uint64_t vk_pipeline_cache_last_save_submission_ = 0;
+  std::atomic<bool> vk_pipeline_cache_saving_{false};
   static bool IsHeavyPipeline(const PipelineCreationArguments& creation_arguments);
   uint64_t pipeline_eviction_check_counter_ = 0;
   uint64_t pipelines_evicted_ = 0;
