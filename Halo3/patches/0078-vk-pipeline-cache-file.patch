diff --git a/src/graphics/vulkan/pipeline_cache.cpp b/src/graphics/vulkan/pipeline_cache.cpp
index e92391e..3c46f9b 100644
--- a/src/graphics/vulkan/pipeline_cache.cpp
+++ b/src/graphics/vulkan/pipeline_cache.cpp
@@ -10,6 +10,8 @@
  */
 
 #include <algorithm>
+#include <chrono>
+#include <thread>
 #include <cstdio>
 #include <mutex>
 #include <unistd.h>
@@ -71,6 +73,9 @@ REXCVAR_DEFINE_INT32(vulkan_pipeline_preload_limit, -1, "GPU/Vulkan",
                      "Create at most this many heavy pipelines (see vulkan_pipeline_live_limit) from "
                      "the pipeline storage at startup (the rest are created when first needed; "
                      "other pipelines are always created). -1 = all");
+REXCVAR_DEFINE_BOOL(vulkan_pipeline_cache_file, true, "GPU/Vulkan",
+                    "Keep the driver's compiled pipeline binaries in a file next to the shader "
+                    "storage so startup is faster");
 REXCVAR_DEFINE_BOOL(vulkan_debug_pipeline_memory, false, "GPU/Vulkan",
                     "Diagnostic: log how much GPU memory (Adreno kgsl) each pipeline creation "
                     "takes, with shader details (creations are serialized while enabled)");
@@ -427,6 +432,44 @@ void VulkanPipelineCache::InitializeShaderStorage(const std::filesystem::path& c
     }
   }
 
+  if (REXCVAR_GET(vulkan_pipeline_cache_file) && vk_pipeline_cache_ == VK_NULL_HANDLE) {
+    vk_pipeline_cache_path_ =
+        shader_storage_shareable_root / fmt::format("{:08X}.vkpipelinecache", title_id);
+    std::vector<uint8_t> initial_data;
+    if (FILE* cache_file = rex::filesystem::OpenFile(vk_pipeline_cache_path_, "rb")) {
+      fseek(cache_file, 0, SEEK_END);
+      long cache_size = ftell(cache_file);
+      fseek(cache_file, 0, SEEK_SET);
+      if (cache_size > 0) {
+        initial_data.resize(size_t(cache_size));
+        if (fread(initial_data.data(), 1, initial_data.size(), cache_file) !=
+            initial_data.size()) {
+          initial_data.clear();
+        }
+      }
+      fclose(cache_file);
+    }
+    const ui::vulkan::VulkanDevice* cache_vulkan_device = command_processor_.GetVulkanDevice();
+    VkPipelineCacheCreateInfo cache_create_info = {};
+    cache_create_info.sType = VK_STRUCTURE_TYPE_PIPELINE_CACHE_CREATE_INFO;
+    cache_create_info.initialDataSize = initial_data.size();
+    cache_create_info.pInitialData = initial_data.empty() ? nullptr : initial_data.data();
+    if (cache_vulkan_device->functions().vkCreatePipelineCache(
+            cache_vulkan_device->device(), &cache_create_info, nullptr, &vk_pipeline_cache_) !=
+        VK_SUCCESS) {
+      // The data may be from another driver - start empty.
+      cache_create_info.initialDataSize = 0;
+      cache_create_info.pInitialData = nullptr;
+      if (cache_vulkan_device->functions().vkCreatePipelineCache(
+              cache_vulkan_device->device(), &cache_create_info, nullptr, &vk_pipeline_cache_) !=
+          VK_SUCCESS) {
+        vk_pipeline_cache_ = VK_NULL_HANDLE;
+      }
+    }
+    REXGPU_INFO("[gpu-pipelines] driver pipeline cache: {} KB loaded, {}",
+                initial_data.size() / 1024, vk_pipeline_cache_ ? "ok" : "failed");
+  }
+
   bool edram_fragment_shader_interlock =
       render_target_cache_.GetPath() == RenderTargetCache::Path::kPixelShaderInterlock;
 
@@ -715,6 +758,7 @@ void VulkanPipelineCache::InitializeShaderStorage(const std::filesystem::path& c
 
     REXGPU_INFO("Created {} graphics pipelines from Vulkan storage ({} requested)",
                 created_pipeline_count.load(), pipeline_creations.size());
+    SaveVkPipelineCache(true);
     {
       std::lock_guard<std::mutex> lock(creation_request_lock_);
       startup_loading_ = false;
@@ -824,6 +868,59 @@ void VulkanPipelineCache::EndSubmission() {
 
   ProcessDeferredPipelineDestructions(false);
   EvictPipelinesOverLimit();
+  // Save new compiled pipelines now and then (Android apps are usually killed
+  // rather than shut down cleanly).
+  uint64_t current_submission = command_processor_.GetCurrentSubmission();
+  if (vk_pipeline_cache_ != VK_NULL_HANDLE &&
+      vk_pipelines_created_since_save_.load(std::memory_order_relaxed) >= 16 &&
+      current_submission >= vk_pipeline_cache_last_save_submission_ + 3600) {
+    vk_pipeline_cache_last_save_submission_ = current_submission;
+    SaveVkPipelineCache(true);
+  }
+}
+
+void VulkanPipelineCache::SaveVkPipelineCache(bool asynchronous) {
+  if (vk_pipeline_cache_ == VK_NULL_HANDLE || vk_pipeline_cache_path_.empty() ||
+      !vk_pipelines_created_since_save_.load(std::memory_order_relaxed) ||
+      vk_pipeline_cache_saving_.exchange(true)) {
+    return;
+  }
+  vk_pipelines_created_since_save_.store(0, std::memory_order_relaxed);
+  auto save = [this]() {
+    const ui::vulkan::VulkanDevice* vulkan_device = command_processor_.GetVulkanDevice();
+    const ui::vulkan::VulkanDevice::Functions& dfn = vulkan_device->functions();
+    size_t data_size = 0;
+    std::vector<uint8_t> data;
+    if (dfn.vkGetPipelineCacheData(vulkan_device->device(), vk_pipeline_cache_, &data_size,
+                                   nullptr) == VK_SUCCESS &&
+        data_size) {
+      data.resize(data_size);
+      if (dfn.vkGetPipelineCacheData(vulkan_device->device(), vk_pipeline_cache_, &data_size,
+                                     data.data()) != VK_SUCCESS) {
+        data.clear();
+      }
+      data.resize(std::min(data.size(), data_size));
+    }
+    if (!data.empty()) {
+      std::filesystem::path temp_path = vk_pipeline_cache_path_;
+      temp_path += ".tmp";
+      if (FILE* file = rex::filesystem::OpenFile(temp_path, "wb")) {
+        bool written = fwrite(data.data(), 1, data.size(), file) == data.size();
+        fclose(file);
+        std::error_code error;
+        if (written) {
+          std::filesystem::rename(temp_path, vk_pipeline_cache_path_, error);
+        }
+        REXGPU_INFO("[gpu-pipelines] driver pipeline cache saved: {} KB", data.size() / 1024);
+      }
+    }
+    vk_pipeline_cache_saving_.store(false);
+  };
+  if (asynchronous) {
+    std::thread(save).detach();
+  } else {
+    save();
+  }
 }
 
 bool VulkanPipelineCache::IsHeavyPipeline(const PipelineCreationArguments& creation_arguments) {
@@ -929,6 +1026,16 @@ void VulkanPipelineCache::Shutdown() {
 
   ProcessDeferredPipelineDestructions(true);
 
+  // Wait for an asynchronous save, save the rest, and destroy the driver cache.
+  while (vk_pipeline_cache_saving_.load()) {
+    std::this_thread::sleep_for(std::chrono::milliseconds(5));
+  }
+  SaveVkPipelineCache(false);
+  if (vk_pipeline_cache_ != VK_NULL_HANDLE) {
+    dfn.vkDestroyPipelineCache(device, vk_pipeline_cache_, nullptr);
+    vk_pipeline_cache_ = VK_NULL_HANDLE;
+  }
+
   // Destroy all pipelines.
   last_pipeline_ = nullptr;
   for (const auto& pipeline_pair : pipelines_) {
@@ -3614,8 +3721,11 @@ bool VulkanPipelineCache::EnsurePipelineCreated(const PipelineCreationArguments&
     debug_memory_lock.lock();
     debug_memory_before = read_gpu_memory();
   }
-  VkResult create_result = dfn.vkCreateGraphicsPipelines(device, VK_NULL_HANDLE, 1,
+  VkResult create_result = dfn.vkCreateGraphicsPipelines(device, vk_pipeline_cache_, 1,
                                                          &pipeline_create_info, nullptr, &pipeline);
+  if (create_result == VK_SUCCESS) {
+    vk_pipelines_created_since_save_.fetch_add(1, std::memory_order_relaxed);
+  }
   if (debug_memory) {
     int64_t debug_memory_after = read_gpu_memory();
     const Shader& vs = creation_arguments.vertex_shader->shader();
