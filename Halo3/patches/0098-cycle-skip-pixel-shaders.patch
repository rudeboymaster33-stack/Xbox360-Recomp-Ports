From fa68e335284ac9c53af57db2046f03349d5f769b Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Sat, 24 Oct 2026 10:56:05 -0400
Subject: [PATCH] gpu_debug_cycle_skip_pixel_shaders: skip candidate pixel
 shaders one at a time on a wall-clock schedule (for timed screenshots)

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01JJM25S15YdvewrFFwP8g6Z
---
 src/graphics/vulkan/command_processor.cpp | 49 +++++++++++++++++++++++
 1 file changed, 49 insertions(+)

diff --git a/src/graphics/vulkan/command_processor.cpp b/src/graphics/vulkan/command_processor.cpp
index f907a27..2505190 100644
--- a/src/graphics/vulkan/command_processor.cpp
+++ b/src/graphics/vulkan/command_processor.cpp
@@ -93,6 +93,11 @@ REXCVAR_DEFINE_INT32(gpu_force_msaa_1x_pitch, 0, "GPU",
 REXCVAR_DEFINE_BOOL(vulkan_debug_msaa_experiment, false, "GPU",
                     "Diagnostic only (breaks visuals): every 600 frames cycle between normal, "
                     "1x1 scissor and skipped draws in 4x MSAA passes, logged as [gpu-exp]");
+REXCVAR_DEFINE_STRING(gpu_debug_cycle_skip_pixel_shaders, "", "GPU",
+                      "Diagnostic: skip the listed guest pixel shaders one at a time, each for "
+                      "gpu_debug_cycle_seconds, then none, and repeat; logs [gpu-cycle] at each "
+                      "switch (for finding an effect's shader with timed screenshots)");
+REXCVAR_DEFINE_INT32(gpu_debug_cycle_seconds, 8, "GPU", "See gpu_debug_cycle_skip_pixel_shaders");
 REXCVAR_DEFINE_STRING(gpu_skip_pixel_shaders, "", "GPU",
                       "Comma-separated hex ucode hashes of guest pixel shaders whose draws are "
                       "skipped (per-game workaround for effects that render incorrectly)");
@@ -4626,6 +4631,50 @@ bool VulkanCommandProcessor::IssueDraw(xenos::PrimitiveType prim_type, uint32_t
       return true;
     }
   }
+  if (pixel_shader && !REXCVAR_GET(gpu_debug_cycle_skip_pixel_shaders).empty()) {
+    static std::vector<uint64_t> cycle_hashes;
+    static bool cycle_parsed = false;
+    static auto cycle_start = std::chrono::steady_clock::now();
+    static int64_t cycle_last_slot = -1;
+    if (!cycle_parsed) {
+      cycle_parsed = true;
+      const std::string& list = REXCVAR_GET(gpu_debug_cycle_skip_pixel_shaders);
+      size_t pos = 0;
+      while (pos < list.size()) {
+        size_t comma = list.find(',', pos);
+        std::string item =
+            list.substr(pos, comma == std::string::npos ? std::string::npos : comma - pos);
+        if (!item.empty()) {
+          cycle_hashes.push_back(std::strtoull(item.c_str(), nullptr, 16));
+        }
+        if (comma == std::string::npos) {
+          break;
+        }
+        pos = comma + 1;
+      }
+    }
+    if (!cycle_hashes.empty()) {
+      // Wall-clock based so timed screenshots (device clock) map to slots.
+      (void)cycle_start;
+      int64_t seconds = std::chrono::duration_cast<std::chrono::seconds>(
+                            std::chrono::system_clock::now().time_since_epoch())
+                            .count();
+      int64_t slot = seconds / std::max(REXCVAR_GET(gpu_debug_cycle_seconds), 1);
+      size_t index = size_t(slot % int64_t(cycle_hashes.size() + 1));
+      if (slot != cycle_last_slot) {
+        cycle_last_slot = slot;
+        if (index < cycle_hashes.size()) {
+          REXGPU_INFO("[gpu-cycle] now skipping pixel shader {:016X} ({} of {})",
+                      cycle_hashes[index], index + 1, cycle_hashes.size());
+        } else {
+          REXGPU_INFO("[gpu-cycle] now skipping nothing");
+        }
+      }
+      if (index < cycle_hashes.size() && pixel_shader->ucode_data_hash() == cycle_hashes[index]) {
+        return true;
+      }
+    }
+  }
   if (pixel_shader && !REXCVAR_GET(gpu_skip_pixel_shaders).empty()) {
     // Skip draws using the listed guest pixel shaders (by ucode hash), as a
     // per-game workaround for an effect that renders incorrectly.
-- 
