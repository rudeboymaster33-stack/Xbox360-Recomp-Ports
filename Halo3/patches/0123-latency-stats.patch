From 385e35a320b291dd060b6641922b73305406dd6f Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Sat, 24 Oct 2026 17:42:38 -0400
Subject: [PATCH] [input-latency] button event -> game read, [frame-latency]
 game frame published -> scheduled on screen

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01JJM25S15YdvewrFFwP8g6Z
---
 include/rex/ui/presenter.h         |  7 +++++++
 src/input/sdl/sdl_input_driver.cpp | 16 ++++++++++++++++
 src/ui/presenter.cpp               |  8 ++++++++
 src/ui/vulkan/vulkan_presenter.cpp | 19 +++++++++++++++++++
 4 files changed, 50 insertions(+)

diff --git a/include/rex/ui/presenter.h b/include/rex/ui/presenter.h
index eaed79a..c94c36e 100644
--- a/include/rex/ui/presenter.h
+++ b/include/rex/ui/presenter.h
@@ -967,6 +967,13 @@ class Presenter {
   // way, with guest output refreshing.
   std::atomic<uint32_t> guest_output_mailbox_acquired_and_ready_{0};
   std::atomic<uint64_t> guest_output_publish_count_{0};
+  // CLOCK_MONOTONIC ns of the last guest output publish (frame latency stats).
+  std::atomic<uint64_t> guest_output_publish_time_ns_{0};
+ public:
+  uint64_t GetGuestOutputPublishTimeNs() const {
+    return guest_output_publish_time_ns_.load(std::memory_order_acquire);
+  }
+ private:
   // The "writable" image is different than both "acquired" and "ready" and is
   // accessible only by the guest output refreshing - it's the image that the
   // refresher may write to.
diff --git a/src/input/sdl/sdl_input_driver.cpp b/src/input/sdl/sdl_input_driver.cpp
index de23a6a..941479d 100644
--- a/src/input/sdl/sdl_input_driver.cpp
+++ b/src/input/sdl/sdl_input_driver.cpp
@@ -591,6 +591,22 @@ void SDLInputDriver::OnControllerDeviceButtonChangedLocked(const SDL_Event& even
     return;
   }
   auto xbutton = xbutton_lookup.at(event.gbutton.button);
+  if (event.gbutton.down) {
+    // [input-latency]: time from the button event to the game reading it.
+    static uint32_t latency_count = 0;
+    static double latency_sum_ms = 0.0, latency_max_ms = 0.0;
+    double latency_ms = double(SDL_GetTicksNS() - event.common.timestamp) * 1e-6;
+    ++latency_count;
+    latency_sum_ms += latency_ms;
+    latency_max_ms = std::max(latency_max_ms, latency_ms);
+    if (latency_count >= 20) {
+      REXLOG_INFO("[input-latency] button press -> game reads it: avg {:.1f} ms, max {:.1f} ms "
+                  "({} presses)",
+                  latency_sum_ms / latency_count, latency_max_ms, latency_count);
+      latency_count = 0;
+      latency_sum_ms = latency_max_ms = 0.0;
+    }
+  }
   // Pressed or released?
   if (event.gbutton.down) {
     if (xbutton == X_INPUT_GAMEPAD_GUIDE && !REXCVAR_GET(guide_button)) {
diff --git a/src/ui/presenter.cpp b/src/ui/presenter.cpp
index c5b07ce..cc5c07f 100644
--- a/src/ui/presenter.cpp
+++ b/src/ui/presenter.cpp
@@ -14,6 +14,7 @@
 #include <cctype>
 #include <utility>
 
+#include <ctime>
 #include <rex/assert.h>
 #include <rex/cvar.h>
 #include <rex/logging.h>
@@ -596,6 +597,13 @@ bool Presenter::RefreshGuestOutput(
       last_acquired_and_ready,
       (last_acquired_and_ready & 3) | (guest_output_mailbox_writable_ << 2),
       std::memory_order_acq_rel, std::memory_order_relaxed)) {}
+  {
+    timespec publish_ts;
+    clock_gettime(CLOCK_MONOTONIC, &publish_ts);
+    guest_output_publish_time_ns_.store(
+        uint64_t(publish_ts.tv_sec) * 1000000000ull + uint64_t(publish_ts.tv_nsec),
+        std::memory_order_release);
+  }
   guest_output_publish_count_.fetch_add(1, std::memory_order_acq_rel);
   // Now, it's known that `ready == writable` on the host presentation side.
   // Take the next `writable` with this assumption about its current value in
diff --git a/src/ui/vulkan/vulkan_presenter.cpp b/src/ui/vulkan/vulkan_presenter.cpp
index f14742d..6480670 100644
--- a/src/ui/vulkan/vulkan_presenter.cpp
+++ b/src/ui/vulkan/vulkan_presenter.cpp
@@ -2405,6 +2405,25 @@ Presenter::PaintResult VulkanPresenter::PaintAndPresentImpl(bool execute_ui_draw
         }
       }
       paint_context_.timing_last_desired_ns = desired;
+      {
+        // [frame-latency]: guest frame finished (published) -> scheduled on
+        // screen.
+        static uint32_t latency_count = 0;
+        static double latency_sum_ms = 0.0, latency_max_ms = 0.0;
+        uint64_t publish_ns = GetGuestOutputPublishTimeNs();
+        if (publish_ns && desired > publish_ns) {
+          double latency_ms = double(desired - publish_ns) * 1e-6;
+          ++latency_count;
+          latency_sum_ms += latency_ms;
+          latency_max_ms = std::max(latency_max_ms, latency_ms);
+        }
+        if (latency_count >= 300) {
+          REXLOG_INFO("[frame-latency] game frame done -> on screen: avg {:.1f} ms, max {:.1f} ms",
+                      latency_sum_ms / latency_count, latency_max_ms);
+          latency_count = 0;
+          latency_sum_ms = latency_max_ms = 0.0;
+        }
+      }
       present_time.presentID = ++paint_context_.timing_present_id;
       present_time.desiredPresentTime = desired;
       present_times_info.sType = VK_STRUCTURE_TYPE_PRESENT_TIMES_INFO_GOOGLE;
-- 
