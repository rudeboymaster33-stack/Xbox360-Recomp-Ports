+#include <future>
 #include <memory>
 #include <set>
 #include <string>
@@ -819,7 +820,15 @@ class VulkanCommandProcessor : public CommandProcessor {
   // A memexport draw was recorded inline in the current pass since its hoist
   // point - later memexport work can't be moved before it.
   bool scope_inline_memexport_ = false;
-  std::unordered_map<uint64_t, VkPipeline> memexport_compute_pipelines_;
+  struct MemExportComputePipeline {
+    VkPipeline pipeline = VK_NULL_HANDLE;
+    // Created on a separate thread, so the first use doesn't stall the frame -
+    // the draw is done the usual (inline) way until it's ready.
+    std::future<VkPipeline> creation;
+    uint64_t ucode_hash = 0;
+  };
+  std::unordered_map<uint64_t, MemExportComputePipeline> memexport_compute_pipelines_;
+  void ShutdownMemExportComputePipelines();
   VkPipeline GetMemExportComputePipeline(VulkanShader& vertex_shader,
                                          SpirvShaderTranslator::Modification graphics_modification,
                                          VkPipelineLayout pipeline_layout);
diff --git a/include/rex/graphics/vulkan/pipeline_cache.h b/include/rex/graphics/vulkan/pipeline_cache.h
