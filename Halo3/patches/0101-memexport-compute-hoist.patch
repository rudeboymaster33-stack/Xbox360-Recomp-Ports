       }
       REXGPU_INFO(
           "[gpu-hoist] per frame: uploads_moved_before_pass={:.1f} uploads_kept={:.1f} "
-          "shm_barriers_in_pass={:.1f} memexport_barriers_deferred={:.1f} memexport_barriers_kept_in_pass={:.1f}",
+          "shm_barriers_in_pass={:.1f} memexport_barriers_deferred={:.1f} memexport_barriers_kept_in_pass={:.1f} memexport_compute_hoisted={:.1f}",
           st.shm_hoisted / f, st.shm_hoist_blocked / f, st.shm_use_barriers_in_pass / f,
-          st.shm_memexport_deferred / f, st.shm_memexport_in_pass_barriers / f);
+          st.shm_memexport_deferred / f, st.shm_memexport_in_pass_barriers / f,
+          st.memexport_compute_hoisted / f);
