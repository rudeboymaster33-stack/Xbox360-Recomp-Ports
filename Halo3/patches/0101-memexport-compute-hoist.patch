+      !memexport_used_pixel && !pixel_shader && !is_rasterization_done &&
+      !memexport_ranges_.empty() &&
+      primitive_processing_result.host_vertex_shader_type ==
+          Shader::HostVertexShaderType::kVertex &&
+      (primitive_processing_result.index_buffer_type ==
+           PrimitiveProcessor::ProcessedIndexBufferType::kNone ||
+       primitive_processing_result.index_buffer_type ==
+           PrimitiveProcessor::ProcessedIndexBufferType::kGuestDMA) &&
+      !vertex_shader->GetUsedTextureMaskAfterTranslation() && !scope_inline_memexport_ &&
+      GetDrawPassHoistPoint(memexport_hoist_index)) {
+    memexport_compute_hoist = true;
+    for (const draw_util::MemExportRange& range : memexport_ranges_) {
+      if (shared_memory_->ScopeReadsOverlapBytes(range.base_address_dwords << 2,
+                                                 range.size_bytes)) {
+        memexport_compute_hoist = false;
+        break;
+      }
+    }
+    memexport_hoist_vertex_count = primitive_processing_result.guest_draw_vertex_count;
+    if (!memexport_hoist_vertex_count) {
+      memexport_compute_hoist = false;
+    }
+  }
+
   // Update system constants before uploading them.
   UpdateSystemConstantValues(primitive_polygonal, primitive_processing_result,
-                             shader_32bit_index_dma, 0, viewport_info, used_texture_mask,
-                             normalized_depth_control, normalized_color_mask);
+                             shader_32bit_index_dma,
+                             memexport_compute_hoist ? memexport_hoist_vertex_count : 0,
+                             viewport_info, used_texture_mask, normalized_depth_control,
+                             normalized_color_mask);
 
   // Update uniform buffers and descriptor sets after binding the pipeline with
   // the new layout.
@@ -5245,6 +5327,42 @@ bool VulkanCommandProcessor::IssueDraw(xenos::PrimitiveType prim_type, uint32_t
     }
   }
 
+  if (memexport_compute_hoist) {
+    // Requesting the ranges above may have ended the pass (uploads that
+    // couldn't be hoisted) - only use the same hoist point.
+    uint32_t hoist_index_now;
+    VkPipeline compute_pipeline = VK_NULL_HANDLE;
+    if (GetDrawPassHoistPoint(hoist_index_now) && hoist_index_now == memexport_hoist_index) {
+      compute_pipeline = GetMemExportComputePipeline(
+          *vertex_shader, vertex_shader_modification,
+          current_guest_graphics_pipeline_layout_->GetPipelineLayout());
+    }
+    if (compute_pipeline != VK_NULL_HANDLE) {
+      uint32_t group_count_x =
+          std::min(memexport_hoist_vertex_count, SpirvShaderTranslator::kMemExportComputeDispatchX);
+      uint32_t group_count_y =
+          (memexport_hoist_vertex_count + SpirvShaderTranslator::kMemExportComputeDispatchX - 1) /
+          SpirvShaderTranslator::kMemExportComputeDispatchX;
+      deferred_command_buffer_.AddHoistedDispatch(
+          memexport_hoist_index, compute_pipeline,
+          current_guest_graphics_pipeline_layout_->GetPipelineLayout(), 0,
+          uint32_t(SpirvShaderTranslator::kDescriptorSetConstants) + 1,
+          current_graphics_descriptor_sets_, group_count_x, group_count_y, 1);
+      // The replay binds a compute pipeline before anything recorded later.
+      current_external_compute_pipeline_ = VK_NULL_HANDLE;
+      shared_memory_->DiscardDrawReads();
+      for (const draw_util::MemExportRange& memexport_range : memexport_ranges_) {
+        shared_memory_->RangeWrittenByGpu(memexport_range.base_address_dwords << 2,
+                                          memexport_range.size_bytes);
+      }
+      ++GetGpuFrameStats().memexport_compute_hoisted;
+      return true;
+    }
+  }
+  if (memexport_writes_possible) {
+    scope_inline_memexport_ = true;
+  }
