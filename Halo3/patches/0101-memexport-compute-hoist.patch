 .../graphics/vulkan/deferred_command_buffer.h |  43 +++++-
 include/rex/graphics/vulkan/shared_memory.h   |  20 +++
 .../pipeline/shader/spirv_translator.cpp      |  11 +-
 src/graphics/vulkan/command_processor.cpp     | 128 +++++++++++++++++-
 .../vulkan/deferred_command_buffer.cpp        |  76 +++++++----
 src/graphics/vulkan/gpu_frame_stats.h         |   3 +-
 7 files changed, 251 insertions(+), 37 deletions(-)

diff --git a/include/rex/graphics/vulkan/command_processor.h b/include/rex/graphics/vulkan/command_processor.h
index e2c0d8b..b62c674 100644
--- a/include/rex/graphics/vulkan/command_processor.h
+++ b/include/rex/graphics/vulkan/command_processor.h
@@ -816,6 +816,13 @@ class VulkanCommandProcessor : public CommandProcessor {
   const VulkanRenderTargetCache::Framebuffer* current_framebuffer_;
   bool in_render_pass_ = false;
   bool pass_allows_vertex_barrier_ = false;
+  // A memexport draw was recorded inline in the current pass since its hoist
+  // point - later memexport work can't be moved before it.
+  bool scope_inline_memexport_ = false;
+  std::unordered_map<uint64_t, VkPipeline> memexport_compute_pipelines_;
+  VkPipeline GetMemExportComputePipeline(VulkanShader& vertex_shader,
+                                         SpirvShaderTranslator::Modification graphics_modification,
+                                         VkPipelineLayout pipeline_layout);
   // Render area tightening for tile-based GPUs: guest draws record their
   // scissor; when the pass ends, the recorded begin-rendering render area is
   // shrunk to the union, so the GPU loads/stores only that part.
diff --git a/include/rex/graphics/vulkan/deferred_command_buffer.h b/include/rex/graphics/vulkan/deferred_command_buffer.h
index 2016663..28d2389 100644
--- a/include/rex/graphics/vulkan/deferred_command_buffer.h
+++ b/include/rex/graphics/vulkan/deferred_command_buffer.h
@@ -288,9 +288,34 @@ class DeferredCommandBuffer {
     }
     HoistBatch& batch = hoist_batches_[hoist_index];
     for (uint32_t i = 0; i < region_count; ++i) {
-      batch.copies.push_back({src_buffer, dst_buffer, regions[i]});
+      HoistedItem item = {};
+      item.copy = {src_buffer, dst_buffer, regions[i]};
+      batch.items.push_back(item);
     }
   }
+  // A compute dispatch replayed at the hoist point, in order with the hoisted
+  // copies (memory export from vertex shaders converted to compute shaders).
+  void AddHoistedDispatch(uint32_t hoist_index, VkPipeline pipeline, VkPipelineLayout layout,
+                          uint32_t first_set, uint32_t set_count, const VkDescriptorSet* sets,
+                          uint32_t group_count_x, uint32_t group_count_y,
+                          uint32_t group_count_z) {
+    if (hoist_index >= hoist_batches_.size() || set_count > kHoistedDispatchMaxSets) {
+      return;
+    }
+    HoistedItem item = {};
+    item.is_dispatch = true;
+    item.dispatch.pipeline = pipeline;
+    item.dispatch.layout = layout;
+    item.dispatch.first_set = first_set;
+    item.dispatch.set_count = set_count;
+    for (uint32_t i = 0; i < set_count; ++i) {
+      item.dispatch.sets[i] = sets[i];
+    }
+    item.dispatch.group_count[0] = group_count_x;
+    item.dispatch.group_count[1] = group_count_y;
+    item.dispatch.group_count[2] = group_count_z;
+    hoist_batches_[hoist_index].items.push_back(item);
+  }
 
   void CmdVkWriteTimestamp(VkPipelineStageFlagBits stage, VkQueryPool query_pool, uint32_t query) {
     auto& args = *reinterpret_cast<ArgsVkWriteTimestamp*>(
@@ -636,8 +661,22 @@ class DeferredCommandBuffer {
     VkBuffer dst;
     VkBufferCopy region;
   };
+  static constexpr uint32_t kHoistedDispatchMaxSets = 4;
+  struct HoistedDispatch {
+    VkPipeline pipeline;
+    VkPipelineLayout layout;
+    uint32_t first_set;
+    uint32_t set_count;
+    VkDescriptorSet sets[kHoistedDispatchMaxSets];
+    uint32_t group_count[3];
+  };
+  struct HoistedItem {
+    bool is_dispatch;
+    HoistedCopy copy;
+    HoistedDispatch dispatch;
+  };
   struct HoistBatch {
-    std::vector<HoistedCopy> copies;
+    std::vector<HoistedItem> items;
   };
   std::vector<HoistBatch> hoist_batches_;
 };
diff --git a/include/rex/graphics/vulkan/shared_memory.h b/include/rex/graphics/vulkan/shared_memory.h
index df8c6ed..dfeaa37 100644
--- a/include/rex/graphics/vulkan/shared_memory.h
+++ b/include/rex/graphics/vulkan/shared_memory.h
@@ -69,6 +69,26 @@ class VulkanSharedMemory : public SharedMemory {
   }
   void NoteDrawRead(uint32_t start, uint32_t length);
   void CommitDrawReads();
+  // Drops the reads collected for the draw being prepared (when its work is
+  // moved to the hoist point instead of being recorded in the pass).
+  void DiscardDrawReads() {
+    draw_reads_.clear();
+    draw_reads_saturated_ = false;
+  }
+  // Whether draws recorded in the pass since the hoist point have read any
+  // byte of [start, start + length).
+  bool ScopeReadsOverlapBytes(uint32_t start, uint32_t length) const {
+    if (scope_saturated_) {
+      return true;
+    }
+    uint64_t end = uint64_t(start) + length;
+    for (const std::pair<uint32_t, uint32_t>& read : scope_reads_) {
+      if (uint64_t(read.first) < end && uint64_t(start) < uint64_t(read.second)) {
+        return true;
+      }
+    }
+    return false;
+  }
 
  protected:
   bool AllocateSparseHostGpuMemoryRange(uint32_t offset_allocations,
