From 437e7484094ec9760d504776a12be6b9ff77936d Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Fri, 23 Oct 2026 22:09:35 -0400
Subject: [PATCH] gpu_debug_special_draws: log draws with non-texture fetch
 constants, tessellation and memexport

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01JJM25S15YdvewrFFwP8g6Z
---
 src/graphics/vulkan/command_processor.cpp | 46 +++++++++++++++++++++++
 1 file changed, 46 insertions(+)

diff --git a/src/graphics/vulkan/command_processor.cpp b/src/graphics/vulkan/command_processor.cpp
index 8fdd7e7..cbcf56a 100644
--- a/src/graphics/vulkan/command_processor.cpp
+++ b/src/graphics/vulkan/command_processor.cpp
@@ -109,6 +109,9 @@ REXCVAR_DEFINE_INT32(gpu_debug_draw_cost, 0, "GPU",
                      "Diagnostic only (breaks visuals): 1 = 1x1 scissor on every draw, "
                      "2 = skip every guest draw, 3 = 1x1 scissor and at most 3 vertices "
                      "per draw (keeps only the fixed per-draw cost)");
+REXCVAR_DEFINE_BOOL(gpu_debug_special_draws, false, "GPU/Debug",
+                    "Log (once per shader pair) draws that texture-fetch from a non-texture fetch "
+                    "constant, tessellated draws, and memexport draws");
 REXCVAR_DEFINE_BOOL(gpu_debug_fault_watch, false, "GPU",
                     "Diagnostic (Android): watch the kernel log for GPU page faults and log which "
                     "shader pairs were drawn in the frames right before them ([gpu-fault])");
@@ -4780,6 +4783,49 @@ bool VulkanCommandProcessor::IssueDraw(xenos::PrimitiveType prim_type, uint32_t
       vertex_shader->GetUsedTextureMaskAfterTranslation() |
       (pixel_shader != nullptr ? pixel_shader->GetUsedTextureMaskAfterTranslation() : 0);
   texture_cache_->RequestTextures(used_texture_mask);
+  if (REXCVAR_GET(gpu_debug_special_draws)) {
+    static std::unordered_set<uint64_t> logged_special;
+    uint64_t pair_key = vertex_shader->ucode_data_hash() * 0x9E3779B97F4A7C15ull ^
+                        (pixel_shader ? pixel_shader->ucode_data_hash() : 0);
+    uint32_t bad_fetch_mask = 0;
+    for (uint32_t i = 0; i < 32; ++i) {
+      if ((used_texture_mask & (1u << i)) &&
+          regs.GetTextureFetch(i).type != xenos::FetchConstantType::kTexture) {
+        bad_fetch_mask |= 1u << i;
+      }
+    }
+    const PrimitiveProcessor::ProcessingResult& pr = primitive_processing_result;
+    bool tess = pr.host_vertex_shader_type != Shader::HostVertexShaderType::kVertex &&
+                pr.host_vertex_shader_type !=
+                    Shader::HostVertexShaderType::kPointListAsTriangleStrip &&
+                pr.host_vertex_shader_type !=
+                    Shader::HostVertexShaderType::kRectangleListAsTriangleStrip;
+    if ((bad_fetch_mask || tess || memexport_used_vertex || memexport_used_pixel) &&
+        logged_special.insert(pair_key ^ (uint64_t(bad_fetch_mask) << 32)).second &&
+        logged_special.size() < 400) {
+      std::string bad_fetch_text;
+      for (uint32_t i = 0; i < 32; ++i) {
+        if (bad_fetch_mask & (1u << i)) {
+          const auto& f = regs.GetTextureFetch(i);
+          bad_fetch_text += fmt::format(" tf{}=({:08X} {:08X} {:08X} {:08X} {:08X} {:08X})", i,
+                                        f.dword_0, f.dword_1, f.dword_2, f.dword_3, f.dword_4,
+                                        f.dword_5);
+        }
+      }
+      REXGPU_INFO(
+          "[gpu-special] vs={:016X} ps={:016X} prim={} n={} host_n={} host_vs_type={} "
+          "vs_memexport={:X} ps_memexport={:X} raster={} vs_tex={:08X} ps_tex={:08X} "
+          "vf0={:08X} tess_factor_range={:08X}{}",
+          vertex_shader->ucode_data_hash(), pixel_shader ? pixel_shader->ucode_data_hash() : 0,
+          uint32_t(prim_type), index_count, pr.host_draw_vertex_count,
+          uint32_t(pr.host_vertex_shader_type), vertex_shader->memexport_eM_written(),
+          pixel_shader ? pixel_shader->memexport_eM_written() : 0, int(is_rasterization_done),
+          vertex_shader->GetUsedTextureMaskAfterTranslation(),
+          pixel_shader ? pixel_shader->GetUsedTextureMaskAfterTranslation() : 0,
+          regs.GetVertexFetch(0).address << 2, regs[XE_GPU_REG_VGT_HOS_MAX_TESS_LEVEL],
+          bad_fetch_text);
+    }
+  }
 
   const VulkanPipelineCache::PipelineLayoutProvider* pipeline_layout_provider;
   // Set up the render targets - this may perform dispatches and draws.
-- 
