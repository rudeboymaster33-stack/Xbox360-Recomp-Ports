From 320824cf9009d49651f823a0641526a272ee9e6e Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Fri, 23 Oct 2026 22:34:33 -0400
Subject: [PATCH] gpu_debug_special_draws: log every vertex fetch constant and
 HOS_CNTL

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01JJM25S15YdvewrFFwP8g6Z
---
 src/graphics/vulkan/command_processor.cpp | 15 ++++++++++++---
 1 file changed, 12 insertions(+), 3 deletions(-)

diff --git a/src/graphics/vulkan/command_processor.cpp b/src/graphics/vulkan/command_processor.cpp
index cbcf56a..4b4a49f 100644
--- a/src/graphics/vulkan/command_processor.cpp
+++ b/src/graphics/vulkan/command_processor.cpp
@@ -4812,18 +4812,27 @@ bool VulkanCommandProcessor::IssueDraw(xenos::PrimitiveType prim_type, uint32_t
                                         f.dword_5);
         }
       }
+      const Shader::ConstantRegisterMap& special_vs_map = vertex_shader->constant_register_map();
+      for (uint32_t i = 0; i < 96; ++i) {
+        if (special_vs_map.vertex_fetch_bitmap[i >> 5] & (1u << (i & 31))) {
+          const auto vf = regs.GetVertexFetch(i);
+          bad_fetch_text += fmt::format(" vf{}=(type={} addr={:08X} size={} endian={})", i,
+                                        uint32_t(vf.type), uint32_t(vf.address) << 2,
+                                        uint32_t(vf.size) << 2, uint32_t(vf.endian));
+        }
+      }
       REXGPU_INFO(
           "[gpu-special] vs={:016X} ps={:016X} prim={} n={} host_n={} host_vs_type={} "
           "vs_memexport={:X} ps_memexport={:X} raster={} vs_tex={:08X} ps_tex={:08X} "
-          "vf0={:08X} tess_factor_range={:08X}{}",
+          "vf0={:08X} tess_factor_range={:08X} hos_cntl={:08X}{}",
           vertex_shader->ucode_data_hash(), pixel_shader ? pixel_shader->ucode_data_hash() : 0,
           uint32_t(prim_type), index_count, pr.host_draw_vertex_count,
           uint32_t(pr.host_vertex_shader_type), vertex_shader->memexport_eM_written(),
           pixel_shader ? pixel_shader->memexport_eM_written() : 0, int(is_rasterization_done),
           vertex_shader->GetUsedTextureMaskAfterTranslation(),
           pixel_shader ? pixel_shader->GetUsedTextureMaskAfterTranslation() : 0,
-          regs.GetVertexFetch(0).address << 2, regs[XE_GPU_REG_VGT_HOS_MAX_TESS_LEVEL],
-          bad_fetch_text);
+          uint32_t(regs.GetVertexFetch(0).address) << 2, regs[XE_GPU_REG_VGT_HOS_MAX_TESS_LEVEL],
+          regs[XE_GPU_REG_VGT_HOS_CNTL], bad_fetch_text);
     }
   }
 
-- 
