From 5221b2eabf28aea7e2262a1e97940148e2568588 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Sat, 24 Oct 2026 12:27:16 -0400
Subject: [PATCH] [gpu-vs-top] host vertices per vertex shader;
 gpu_debug_cycle_vs_cost: cycle reducing one top vertex shader's draws to a
 tiny triangle

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01JJM25S15YdvewrFFwP8g6Z
---
 src/graphics/vulkan/command_processor.cpp | 74 +++++++++++++++++++++++
 1 file changed, 74 insertions(+)

diff --git a/src/graphics/vulkan/command_processor.cpp b/src/graphics/vulkan/command_processor.cpp
index 1d17a73..fe8c457 100644
--- a/src/graphics/vulkan/command_processor.cpp
+++ b/src/graphics/vulkan/command_processor.cpp
@@ -128,6 +128,11 @@ REXCVAR_DEFINE_INT32(gpu_debug_draw_cost, 0, "GPU",
 REXCVAR_DEFINE_BOOL(gpu_debug_cycle_draw_cost, false, "GPU",
                     "Diagnostic only (breaks visuals): cycle gpu_debug_draw_cost through "
                     "0, 1, 3, 2 every gpu_debug_cycle_seconds (wall clock), logging [gpu-cycle]");
+REXCVAR_DEFINE_INT32(gpu_debug_cycle_vs_cost, 0, "GPU",
+                     "Diagnostic only (breaks visuals): after gpu_debug_cycle_start_seconds, "
+                     "take the N vertex shaders with the most vertices in the last stats window "
+                     "and, every gpu_debug_cycle_seconds, reduce the draws of one of them to a "
+                     "single 1x1 triangle (then none, and repeat), logging [gpu-cycle]");
 REXCVAR_DEFINE_INT32(gpu_debug_cycle_start_seconds, 0, "GPU",
                      "Start gpu_debug_cycle_draw_cost this many seconds after the first draw");
 REXCVAR_DEFINE_BOOL(gpu_debug_special_draws, false, "GPU/Debug",
@@ -155,6 +160,16 @@ REXCVAR_DEFINE_BOOL(vulkan_tight_render_area, true, "GPU",
                     "(large win on tile-based mobile GPUs)");
 
 #include "gpu_frame_stats.h"
+
+namespace rex::graphics::vulkan {
+namespace {
+// Host vertices and draws per guest vertex shader in the current stats window
+// ([gpu-vs-top]), and the top list of the last window.
+std::unordered_map<uint64_t, std::pair<uint64_t, uint64_t>> debug_vs_vertices;
+std::vector<std::pair<uint64_t, uint64_t>> debug_vs_top_last;
+}  // namespace
+}  // namespace rex::graphics::vulkan
+
 #include <rex/graphics/swap_hints.h>
 #if !defined(_WIN32)
 #include <cxxabi.h>
@@ -2656,6 +2671,26 @@ void VulkanCommandProcessor::IssueSwap(uint32_t frontbuffer_ptr, uint32_t frontb
       fps_last_time = fps_now;
       REXGPU_INFO("[gpu-binds] per frame: draws={:.0f} pipeline_binds={:.0f} descriptor_set_binds={:.0f}",
                   st.draws / f, st.pipeline_binds / f, st.descriptor_set_binds / f);
+      {
+        std::vector<std::pair<uint64_t, uint64_t>> vs_sorted;
+        vs_sorted.reserve(debug_vs_vertices.size());
+        for (const auto& vs_pair : debug_vs_vertices) {
+          vs_sorted.emplace_back(vs_pair.second.first, vs_pair.first);
+        }
+        std::sort(vs_sorted.begin(), vs_sorted.end(), std::greater<>());
+        std::string vs_text;
+        for (size_t i = 0; i < std::min(vs_sorted.size(), size_t(10)); ++i) {
+          const auto& counts = debug_vs_vertices[vs_sorted[i].second];
+          vs_text += fmt::format(" {:016X}:{:.0f}k/{:.0f}", vs_sorted[i].second,
+                                 counts.first / f / 1000.0, counts.second / f);
+        }
+        REXGPU_INFO("[gpu-vs-top] per frame (VS:kverts/draws):{}", vs_text);
+        debug_vs_top_last.clear();
+        for (const auto& vs_entry : vs_sorted) {
+          debug_vs_top_last.emplace_back(vs_entry.second, vs_entry.first);
+        }
+        debug_vs_vertices.clear();
+      }
       REXGPU_INFO("[gpu-fps] {:.1f} frames per second ({:.1f} ms per frame)",
                   fps_seconds > 0.0 ? f / fps_seconds : 0.0,
                   fps_seconds * 1000.0 / f);
@@ -5569,8 +5604,47 @@ bool VulkanCommandProcessor::IssueDraw(xenos::PrimitiveType prim_type, uint32_t
   if (gpu_ts_cur_slot_) {
     gpu_ts_slot_verts_[gpu_ts_cur_slot_ - 1] += primitive_processing_result.host_draw_vertex_count;
   }
+  {
+    auto& vs_counts = debug_vs_vertices[vertex_shader->ucode_data_hash()];
+    vs_counts.first += primitive_processing_result.host_draw_vertex_count;
+    ++vs_counts.second;
+  }
   int32_t debug_draw_cost_now = REXCVAR_GET(gpu_debug_draw_cost);
   static const auto debug_cycle_first_draw = std::chrono::steady_clock::now();
+  if (int32_t cycle_vs_count = REXCVAR_GET(gpu_debug_cycle_vs_cost)) {
+    static std::vector<std::pair<uint64_t, uint64_t>> cycle_vs_list;
+    static bool cycle_vs_frozen = false;
+    static int64_t cycle_vs_last_slot = -1;
+    if (std::chrono::steady_clock::now() - debug_cycle_first_draw >=
+        std::chrono::seconds(REXCVAR_GET(gpu_debug_cycle_start_seconds))) {
+      if (!cycle_vs_frozen) {
+        cycle_vs_frozen = true;
+        cycle_vs_list.assign(
+            debug_vs_top_last.begin(),
+            debug_vs_top_last.begin() +
+                std::min(debug_vs_top_last.size(), size_t(std::max(cycle_vs_count, 0))));
+      }
+      int64_t seconds = std::chrono::duration_cast<std::chrono::seconds>(
+                            std::chrono::system_clock::now().time_since_epoch())
+                            .count();
+      int64_t slot = seconds / std::max(REXCVAR_GET(gpu_debug_cycle_seconds), 1);
+      size_t index = size_t(slot % int64_t(cycle_vs_list.size() + 1));
+      if (slot != cycle_vs_last_slot) {
+        cycle_vs_last_slot = slot;
+        if (index < cycle_vs_list.size()) {
+          REXGPU_INFO("[gpu-cycle] vs={:016X} ({} of {}) window_vertices={}",
+                      cycle_vs_list[index].first, index + 1, cycle_vs_list.size(),
+                      cycle_vs_list[index].second);
+        } else {
+          REXGPU_INFO("[gpu-cycle] vs=none");
+        }
+      }
+      if (index < cycle_vs_list.size() &&
+          vertex_shader->ucode_data_hash() == cycle_vs_list[index].first) {
+        debug_draw_cost_now = 3;
+      }
+    }
+  }
   if (REXCVAR_GET(gpu_debug_cycle_draw_cost) &&
       std::chrono::steady_clock::now() - debug_cycle_first_draw >=
           std::chrono::seconds(REXCVAR_GET(gpu_debug_cycle_start_seconds))) {
-- 
