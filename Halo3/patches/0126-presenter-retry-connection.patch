From 4d1dd4c8a503901592d15cf2c789c55664913d4c Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Sat, 24 Oct 2026 19:34:20 -0400
Subject: [PATCH] Presenter (Android): retry a failed surface connection every
 500 ms (black screen when started with the screen off)

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01JJM25S15YdvewrFFwP8g6Z
---
 src/ui/presenter.cpp | 24 ++++++++++++++++++++++++
 1 file changed, 24 insertions(+)

diff --git a/src/ui/presenter.cpp b/src/ui/presenter.cpp
index cc5c07f..da0bc7f 100644
--- a/src/ui/presenter.cpp
+++ b/src/ui/presenter.cpp
@@ -15,6 +15,7 @@
 #include <utility>
 
 #include <ctime>
+#include <chrono>
 #include <rex/assert.h>
 #include <rex/cvar.h>
 #include <rex/logging.h>
@@ -473,6 +474,21 @@ void Presenter::PaintFromUIThread(bool force_paint) {
     if (surface_paint_connection_state_ == SurfacePaintConnectionState::kConnectedOutdated) {
       UpdateSurfacePaintConnectionFromUIThread(nullptr, false);
     }
+#if REX_PLATFORM_ANDROID
+    // A connection that failed (e.g. the game started while the screen was off
+    // and the swapchain couldn't be created) is otherwise retried only on a
+    // surface size change, which may never come - retry periodically.
+    if (surface_paint_connection_state_ ==
+            SurfacePaintConnectionState::kUnconnectedRetryAtStateChange &&
+        surface_) {
+      static auto last_retry = std::chrono::steady_clock::time_point();
+      auto now = std::chrono::steady_clock::now();
+      if (now - last_retry > std::chrono::milliseconds(500)) {
+        last_retry = now;
+        UpdateSurfacePaintConnectionFromUIThread(nullptr, false);
+      }
+    }
+#endif
     // If still paintable or recovered successfully, paint.
     if (surface_paint_connection_state_ == SurfacePaintConnectionState::kConnectedPaintable) {
       // The paint mode might have been set to kNone when the connection was
@@ -633,6 +649,14 @@ bool Presenter::RefreshGuestOutput(
     switch (paint_mode_) {
       case PaintMode::kNone:
         // Neither painting nor window paint requesting is accessible.
+#if REX_PLATFORM_ANDROID
+        // Except to retry a failed connection (see PaintFromUIThread).
+        if (window_ && surface_ &&
+            surface_paint_connection_state_ ==
+                SurfacePaintConnectionState::kUnconnectedRetryAtStateChange) {
+          RequestPaintOrConnectionRecoveryViaWindow(true);
+        }
+#endif
         break;
       case PaintMode::kUIThreadOnRequest:
         // Only window paint requesting is accessible.
