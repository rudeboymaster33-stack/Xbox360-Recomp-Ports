From e35c587a31cad6518fd21f898b32cedef147e17c Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Sat, 24 Oct 2026 20:00:15 -0400
Subject: [PATCH] Android: reconnect the surface on return from the background
 (foreground events in the event watch, window events); pacing defaults back
 to 8 ms

With the game paused in the background, nothing painted after returning, so
the surface was never reconnected (black screen with sound). The judder was a
game visual, not the pacing.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01JJM25S15YdvewrFFwP8g6Z
---
 src/ui/vulkan/vulkan_presenter.cpp  | 4 ++--
 src/ui/window_sdl.cpp               | 8 ++++++++
 src/ui/windowed_app_context_sdl.cpp | 9 +++++++++
 3 files changed, 19 insertions(+), 2 deletions(-)

diff --git a/src/ui/vulkan/vulkan_presenter.cpp b/src/ui/vulkan/vulkan_presenter.cpp
index c70644c..76702bd 100644
--- a/src/ui/vulkan/vulkan_presenter.cpp
+++ b/src/ui/vulkan/vulkan_presenter.cpp
@@ -57,10 +57,10 @@ REXCVAR_DEFINE_BOOL(vulkan_present_display_timing, true, "UI/Vulkan",
 REXCVAR_DEFINE_BOOL(vulkan_present_pacing_max_lead, true, "UI/Vulkan",
                     "Paced presentation: never schedule a frame more than one refresh past "
                     "the target lead (lower input-to-screen latency)");
-REXCVAR_DEFINE_INT32(vulkan_present_pacing_latency_ms, 25, "UI/Vulkan",
+REXCVAR_DEFINE_INT32(vulkan_present_pacing_latency_ms, 8, "UI/Vulkan",
                      "Paced presentation: how far ahead (ms) a frame is scheduled when the even "
                      "cadence (re)starts - headroom that absorbs frames arriving a little late");
-REXCVAR_DEFINE_INT32(vulkan_present_pacing_min_lead_ms, 25, "UI/Vulkan",
+REXCVAR_DEFINE_INT32(vulkan_present_pacing_min_lead_ms, 8, "UI/Vulkan",
                      "Paced presentation: a frame keeps its place in the cadence as long as it "
                      "arrives at least this many ms before its scheduled time");
 REXCVAR_DEFINE_BOOL(vulkan_present_pacing_median, true, "Vulkan",
diff --git a/src/ui/window_sdl.cpp b/src/ui/window_sdl.cpp
index 0706aae..3ebfa2b 100644
--- a/src/ui/window_sdl.cpp
+++ b/src/ui/window_sdl.cpp
@@ -492,6 +492,14 @@ void WindowSDL::HandleAppLifecycle(bool foreground) {
 
 void WindowSDL::HandleWindowEvent(SDL_Event& event) {
   WindowDestructionReceiver destruction_receiver(this);
+#if REX_PLATFORM_ANDROID
+  // Window events arrive when the activity returns; pick up a new native
+  // window here too (with the game paused, no paints would do it).
+  RefreshAndroidSurface();
+  if (destruction_receiver.IsWindowDestroyed()) {
+    return;
+  }
+#endif
   switch (event.type) {
     case SDL_EVENT_WINDOW_PIXEL_SIZE_CHANGED:
       OnActualSizeUpdate(uint32_t(event.window.data1), uint32_t(event.window.data2),
diff --git a/src/ui/windowed_app_context_sdl.cpp b/src/ui/windowed_app_context_sdl.cpp
index 46dba33..98f684b 100644
--- a/src/ui/windowed_app_context_sdl.cpp
+++ b/src/ui/windowed_app_context_sdl.cpp
@@ -242,6 +242,15 @@ bool SDLCALL SDLWindowedAppContext::WatchEvent(void* userdata, SDL_Event* event)
       window->HandleAppLifecycle(false);
     }
   }
+  // The foreground events aren't reliably seen in the queue either, and with
+  // the game paused nothing else would reconnect the surface.
+  if ((event->type == SDL_EVENT_WILL_ENTER_FOREGROUND ||
+       event->type == SDL_EVENT_DID_ENTER_FOREGROUND) &&
+      context->IsInUIThread()) {
+    for (auto& [id, window] : context->windows_) {
+      window->HandleAppLifecycle(true);
+    }
+  }
 #endif
   return true;
 }
