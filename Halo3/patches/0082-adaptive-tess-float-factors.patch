From 25ea590cb92a3ba349f039cda30ba4e21ad1efd1 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Fri, 23 Oct 2026 22:27:10 -0400
Subject: [PATCH] Vulkan tessellation: adaptive edge factors are float32 bits
 in the index buffer (uintBitsToFloat), fix 16-in-32 index endian

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01JJM25S15YdvewrFFwP8g6Z
---
 src/graphics/vulkan/pipeline_cache.cpp | 11 ++++++++---
 1 file changed, 8 insertions(+), 3 deletions(-)

diff --git a/src/graphics/vulkan/pipeline_cache.cpp b/src/graphics/vulkan/pipeline_cache.cpp
index 3c46f9b..3575d20 100644
--- a/src/graphics/vulkan/pipeline_cache.cpp
+++ b/src/graphics/vulkan/pipeline_cache.cpp
@@ -152,7 +152,8 @@ uint xe_swap_16_in_32(uint value) {
 void main() {
   uint value = uint(gl_VertexIndex);
   uint endian = xe_system_cbuffer.xe_vertex_index_endian;
-  if (endian == 1u || endian == 2u || endian == 3u) {
+  // xenos::Endian: 1 = 8-in-16, 2 = 8-in-32, 3 = 16-in-32.
+  if (endian == 1u || endian == 2u) {
     value = xe_swap_8_in_16(value);
   }
   if (endian == 2u || endian == 3u) {
@@ -186,13 +187,17 @@ uint xe_swap_16_in_32(uint value) {
 void main() {
   uint value = uint(gl_VertexIndex);
   uint endian = xe_system_cbuffer.xe_vertex_index_endian;
-  if (endian == 1u || endian == 2u || endian == 3u) {
+  // xenos::Endian: 1 = 8-in-16, 2 = 8-in-32, 3 = 16-in-32.
+  if (endian == 1u || endian == 2u) {
     value = xe_swap_8_in_16(value);
   }
   if (endian == 2u || endian == 3u) {
     value = xe_swap_16_in_32(value);
   }
-  float tessellation_factor = float(value) + 1.0;
+  // The Xbox 360 takes the float32 edge tessellation factors for adaptive
+  // tessellation through the index buffer - reinterpret the bits, don't
+  // convert the integer.
+  float tessellation_factor = uintBitsToFloat(value) + 1.0;
   tessellation_factor = max(
       tessellation_factor, xe_system_cbuffer.xe_tessellation_factor_range_min);
   tessellation_factor = min(
