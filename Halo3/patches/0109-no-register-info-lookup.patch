From b202ffa48e3af79face39c17c869c82f3cc78680 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Sat, 24 Oct 2026 15:40:30 -0400
Subject: [PATCH] Don't look up register info on every register write (debug
 log only)

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01JJM25S15YdvewrFFwP8g6Z
---
 src/graphics/command_processor.cpp | 3 ---
 1 file changed, 3 deletions(-)

diff --git a/src/graphics/command_processor.cpp b/src/graphics/command_processor.cpp
index 388391f..2950d85 100644
--- a/src/graphics/command_processor.cpp
+++ b/src/graphics/command_processor.cpp
@@ -368,9 +368,6 @@ void CommandProcessor::WriteRegister(uint32_t index, uint32_t value) {
 
   // Volatile for the WAIT_REG_MEM loop.
   const_cast<volatile uint32_t&>(regs.values[index]) = value;
-  if (!regs.GetRegisterInfo(index)) {
-    REXGPU_DEBUG("GPU: Write to unknown register ({:04X} = {:08X})", index, value);
-  }
 
   // Scratch register writeback.
   if (index >= XE_GPU_REG_SCRATCH_REG0 && index <= XE_GPU_REG_SCRATCH_REG7) {
-- 
