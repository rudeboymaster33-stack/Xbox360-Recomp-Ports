Date: Fri, 23 Oct 2026 21:02:56 -0400
Subject: [PATCH] spirv: gpu_shader_structured_loops - structured SPIR-V loops
 for shaders whose only control flow is guest loops (no program counter
 switch)

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01JJM25S15YdvewrFFwP8g6Z
---
 .../pipeline/shader/spirv_translator.h        |  14 ++
 .../pipeline/shader/spirv_translator.cpp      | 153 +++++++++++++++++-
 2 files changed, 163 insertions(+), 4 deletions(-)

diff --git a/include/rex/graphics/pipeline/shader/spirv_translator.h b/include/rex/graphics/pipeline/shader/spirv_translator.h
index 63cd56c..40e3413 100644
--- a/include/rex/graphics/pipeline/shader/spirv_translator.h
+++ b/include/rex/graphics/pipeline/shader/spirv_translator.h
@@ -1061,6 +1061,20 @@ class SpirvShaderTranslator : public ShaderTranslator {
   spv::Block* main_switch_merge_;
   std::vector<spv::Id> main_switch_next_pc_phi_operands_;
 
+  // gpu_shader_structured_loops: shaders whose only control flow is properly
+  // nested guest loops are translated to structured SPIR-V loops instead of a
+  // program counter switch inside the main loop.
+  bool IsStructuredLoopsEligible() const;
+  bool use_main_switch_ = false;
+  bool structured_loops_ = false;
+  struct StructuredLoop {
+    spv::Block* header;
+    spv::Block* merge;
+    spv::Block* continue_target;
+    spv::Block* join;
+  };
+  std::vector<StructuredLoop> structured_loop_stack_;
+
   // If the exec bool constant / predicate conditional is open, block after it
   // (not added to the function yet).
   spv::Block* cf_exec_conditional_merge_;
diff --git a/src/graphics/pipeline/shader/spirv_translator.cpp b/src/graphics/pipeline/shader/spirv_translator.cpp
index 8ad96c8..e14243e 100644
--- a/src/graphics/pipeline/shader/spirv_translator.cpp
+++ b/src/graphics/pipeline/shader/spirv_translator.cpp
@@ -15,6 +15,7 @@
 #include <memory>
 #include <string>
 #include <utility>
+#include <set>
 #include <vector>
 
 #include <SPIRV/GLSL.std.450.h>
@@ -43,6 +44,10 @@ REXCVAR_DEFINE_BOOL(gpu_shader_split_registers, false, "GPU/Shader",
                     "Keep each guest register of a shader without dynamic register addressing in "
                     "its own variable instead of one array (some mobile drivers put such arrays in "
                     "per-pipeline scratch memory - about 10 MB of GPU memory per pipeline on Adreno)");
+REXCVAR_DEFINE_BOOL(gpu_shader_structured_loops, false, "GPU/Shader",
+                    "Translate shaders whose only control flow is guest loops into structured "
+                    "SPIR-V loops instead of a program counter switch (Adreno gives switch-based "
+                    "loop shaders ~24 MB of scratch memory per pipeline)");
 REXCVAR_DEFINE_INT32(gpu_shader_spirv_optimize, 0, "GPU/Shader",
                      "Run the SPIRV-Tools optimizer on translated shaders (Android builds): 0 = off, "
                      "1 = performance passes (SSA, no Function variables), 2 = size passes");
@@ -210,6 +215,9 @@ void SpirvShaderTranslator::Reset() {
 
   main_switch_op_.reset();
   main_switch_next_pc_phi_operands_.clear();
+  use_main_switch_ = false;
+  structured_loops_ = false;
+  structured_loop_stack_.clear();
   main_loop_exit_ = nullptr;
 
   cf_exec_conditional_merge_ = nullptr;
@@ -673,7 +681,14 @@ void SpirvShaderTranslator::StartTranslation() {
 
   // If no jumps, don't create a switch, but still create a loop so exece can
   // break.
-  bool has_main_switch = !current_shader().label_addresses().empty();
+  use_main_switch_ = !current_shader().label_addresses().empty();
+  structured_loops_ = false;
+  if (use_main_switch_ && REXCVAR_GET(gpu_shader_structured_loops) &&
+      IsStructuredLoopsEligible()) {
+    use_main_switch_ = false;
+    structured_loops_ = true;
+  }
+  bool has_main_switch = use_main_switch_;
 
   // Main loop header - based on whether it's the first iteration (entered from
   // the function or from the continuation), choose the program counter.
@@ -725,7 +740,7 @@ std::vector<uint8_t> SpirvShaderTranslator::CompleteTranslation() {
   if (!is_depth_only_fragment_shader_) {
     // Close flow control within the last switch case.
     CloseExecConditionals();
-    bool has_main_switch = !current_shader().label_addresses().empty();
+    bool has_main_switch = use_main_switch_;
     // After the final exec (if it happened to be not exece, which would already
     // have a break branch), break from the switch if it exists, or from the
     // loop it doesn't.
@@ -1383,6 +1398,54 @@ void SpirvShaderTranslator::PostTranslation() {
   }
 }
 
+bool SpirvShaderTranslator::IsStructuredLoopsEligible() const {
+  const Shader& shader = current_shader();
+  const uint32_t* ucode_dwords = shader.ucode_data().data();
+  uint32_t cf_pair_index_bound = shader.cf_pair_index_bound();
+  // (loop start index, skip address).
+  std::vector<std::pair<uint32_t, uint32_t>> loop_stack;
+  std::set<uint32_t> loop_labels;
+  for (uint32_t i = 0; i < cf_pair_index_bound; ++i) {
+    ucode::ControlFlowInstruction cf_ab[2];
+    ucode::UnpackControlFlowInstructions(ucode_dwords + i * 3, cf_ab);
+    for (uint32_t j = 0; j < 2; ++j) {
+      uint32_t cf_index = i * 2 + j;
+      const ucode::ControlFlowInstruction& cf = cf_ab[j];
+      switch (cf.opcode()) {
+        case ucode::ControlFlowOpcode::kCondCall:
+        case ucode::ControlFlowOpcode::kReturn:
+        case ucode::ControlFlowOpcode::kCondJmp:
+          return false;
+        case ucode::ControlFlowOpcode::kLoopStart:
+          if (loop_stack.size() >= 4) {
+            return false;
+          }
+          loop_stack.emplace_back(cf_index, cf.loop_start.address());
+          break;
+        case ucode::ControlFlowOpcode::kLoopEnd: {
+          if (loop_stack.empty()) {
+            return false;
+          }
+          auto loop = loop_stack.back();
+          loop_stack.pop_back();
+          if (cf.loop_end.address() != loop.first + 1 || loop.second != cf_index + 1) {
+            return false;
+          }
+          loop_labels.insert(loop.first + 1);
+          loop_labels.insert(cf_index + 1);
+        } break;
+        default:
+          if (ucode::IsControlFlowOpcodeExec(cf.opcode()) &&
+              ucode::DoesControlFlowOpcodeEndShader(cf.opcode()) && !loop_stack.empty()) {
+            return false;
+          }
+          break;
+      }
+    }
+  }
+  return loop_stack.empty() && loop_labels == shader.label_addresses();
+}
+
 void SpirvShaderTranslator::ProcessLabel(uint32_t cf_index) {
   if (cf_index == 0) {
     // 0 already added in the beginning.
@@ -1390,6 +1453,11 @@ void SpirvShaderTranslator::ProcessLabel(uint32_t cf_index) {
   }
 
   assert_false(current_shader().label_addresses().empty());
+  if (!use_main_switch_) {
+    // Structured loops - labels are only loop bodies and loop exits, already
+    // handled by the loop instructions.
+    return;
+  }
 
   // Close flow control within the previous switch case.
   CloseExecConditionals();
@@ -1419,8 +1487,7 @@ void SpirvShaderTranslator::ProcessExecInstructionEnd(const ParsedExecInstructio
     // Break out of the main switch (if exists) and the main loop.
     CloseInstructionPredication();
     if (!builder_->getBuildPoint()->isTerminated()) {
-      builder_->createBranch(current_shader().label_addresses().empty() ? main_loop_merge_
-                                                                        : main_switch_merge_);
+      builder_->createBranch(use_main_switch_ ? main_switch_merge_ : main_loop_merge_);
     }
   }
   UpdateExecConditionals(instr.type, instr.bool_constant_index, instr.condition);
@@ -1492,6 +1559,24 @@ void SpirvShaderTranslator::ProcessLoopStartInstruction(const ParsedLoopStartIns
   spv::Block& head_block = *builder_->getBuildPoint();
   spv::Id loop_count_zero =
       builder_->createBinOp(spv::OpIEqual, type_bool_, loop_count_new, const_uint_0_);
+  if (structured_loops_) {
+    // if (count != 0) { loop { body } } - skipping goes to the join block.
+    spv::Block* join = new spv::Block(builder_->getUniqueId(), *function_main_);
+    spv::Block& loop_header = builder_->makeNewBlock();
+    builder_->createSelectionMerge(join, spv::SelectionControlMaskNone);
+    builder_->createConditionalBranch(loop_count_zero, join, &loop_header);
+    builder_->setBuildPoint(&loop_header);
+    spv::Block* loop_merge = new spv::Block(builder_->getUniqueId(), *function_main_);
+    spv::Block* loop_continue = new spv::Block(builder_->getUniqueId(), *function_main_);
+    uint_vector_temp_.clear();
+    builder_->createLoopMerge(loop_merge, loop_continue, spv::LoopControlDontUnrollMask,
+                              uint_vector_temp_);
+    spv::Block& loop_body = builder_->makeNewBlock();
+    builder_->createBranch(&loop_body);
+    builder_->setBuildPoint(&loop_body);
+    structured_loop_stack_.push_back({&loop_header, loop_merge, loop_continue, join});
+    return;
+  }
   spv::Block& skip_block = builder_->makeNewBlock();
   spv::Block& body_block = builder_->makeNewBlock();
   builder_->createSelectionMerge(&body_block, spv::SelectionControlMaskNone);
@@ -1548,6 +1633,66 @@ void SpirvShaderTranslator::ProcessLoopEndInstruction(const ParsedLoopEndInstruc
         builder_->createLoad(var_main_predicate_, spv::NoPrecision));
   }
 
+  if (structured_loops_ && !structured_loop_stack_.empty()) {
+    StructuredLoop loop = structured_loop_stack_.back();
+    structured_loop_stack_.pop_back();
+    // Back edge through the continue target, or break to the merge block.
+    if (break_is_true) {
+      builder_->createConditionalBranch(condition, loop.merge, loop.continue_target);
+    } else {
+      builder_->createConditionalBranch(condition, loop.continue_target, loop.merge);
+    }
+    // Continue - store the decremented count and step aL.
+    function_main_->addBlock(loop.continue_target);
+    builder_->setBuildPoint(loop.continue_target);
+    builder_->createStore(
+        builder_->createCompositeInsert(loop_count, loop_count_stack_old, type_uint4_, 0),
+        var_main_loop_count_);
+    id_vector_temp_.clear();
+    id_vector_temp_.push_back(builder_->makeIntConstant(1));
+    id_vector_temp_.push_back(builder_->makeIntConstant(int(instr.loop_constant_index >> 2)));
+    id_vector_temp_.push_back(builder_->makeIntConstant(int(instr.loop_constant_index & 3)));
+    spv::Id loop_constant_structured = builder_->createLoad(
+        builder_->createAccessChain(spv::StorageClassUniform, uniform_bool_loop_constants_,
+                                    id_vector_temp_),
+        spv::NoPrecision);
+    builder_->createStore(
+        builder_->createCompositeInsert(
+            builder_->createBinOp(
+                spv::OpIAdd, type_int_,
+                builder_->createCompositeExtract(address_relative_stack_old, type_int_, 0),
+                builder_->createTriOp(
+                    spv::OpBitFieldSExtract, type_int_,
+                    builder_->createUnaryOp(spv::OpBitcast, type_int_, loop_constant_structured),
+                    builder_->makeIntConstant(16), builder_->makeIntConstant(8))),
+            address_relative_stack_old, type_int4_, 0),
+        var_main_loop_address_);
+    builder_->createBranch(loop.header);
+    // Exit - pop the loop counter and the relative address stacks.
+    function_main_->addBlock(loop.merge);
+    builder_->setBuildPoint(loop.merge);
+    id_vector_temp_.clear();
+    for (unsigned int i = 1; i < 4; ++i) {
+      id_vector_temp_.push_back(
+          builder_->createCompositeExtract(loop_count_stack_old, type_uint_, i));
+    }
+    id_vector_temp_.push_back(const_uint_0_);
+    builder_->createStore(builder_->createCompositeConstruct(type_uint4_, id_vector_temp_),
+                          var_main_loop_count_);
+    id_vector_temp_.clear();
+    for (unsigned int i = 1; i < 4; ++i) {
+      id_vector_temp_.push_back(
+          builder_->createCompositeExtract(address_relative_stack_old, type_int_, i));
+    }
+    id_vector_temp_.push_back(const_int_0_);
+    builder_->createStore(builder_->createCompositeConstruct(type_int4_, id_vector_temp_),
+                          var_main_loop_address_);
+    builder_->createBranch(loop.join);
+    function_main_->addBlock(loop.join);
+    builder_->setBuildPoint(loop.join);
+    return;
+  }
+
   spv::Block& body_block = *builder_->getBuildPoint();
   spv::Block& continue_block = builder_->makeNewBlock();
   spv::Block& break_block = builder_->makeNewBlock();
