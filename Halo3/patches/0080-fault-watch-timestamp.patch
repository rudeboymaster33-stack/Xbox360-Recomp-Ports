From eb71991ce0fb21fe976382a230279fb81771f5e1 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Fri, 23 Oct 2026 22:02:23 -0400
Subject: [PATCH] gpu_debug_fault_watch: detect faults from a changing
 count/timestamp file, wider window, log events

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01JJM25S15YdvewrFFwP8g6Z
---
 src/graphics/vulkan/command_processor.cpp | 39 ++++++++++++++---------
 1 file changed, 24 insertions(+), 15 deletions(-)

diff --git a/src/graphics/vulkan/command_processor.cpp b/src/graphics/vulkan/command_processor.cpp
index 134256a..8fdd7e7 100644
--- a/src/graphics/vulkan/command_processor.cpp
+++ b/src/graphics/vulkan/command_processor.cpp
@@ -2387,11 +2387,13 @@ struct GpuFaultWatch {
   uint64_t file_count = 0;
   uint64_t file_check_frame = 0;
   bool frames_seen_file = false;
+  std::string file_text;
   std::unordered_set<uint64_t> frame_keys;
   std::deque<std::unordered_set<uint64_t>> recent_frames;
   std::unordered_map<uint64_t, uint64_t> used_frames;
   std::unordered_map<uint64_t, uint64_t> fault_frames;
   std::unordered_map<uint64_t, std::pair<uint64_t, uint64_t>> key_shaders;
+  std::unordered_map<uint64_t, uint32_t> key_flags;
   uint64_t frames = 0;
   uint64_t faults = 0;
   uint64_t fault_events = 0;
@@ -2411,29 +2413,31 @@ uint32_t GpuFaultWatchReadFaults() {
   if (g_fault_watch.kmsg_fd < 0) {
     // Apps can't read the kernel log, so the test script counts GPU page
     // faults with dmesg and writes the running total into this file.
-    if (g_fault_watch.frames < g_fault_watch.file_check_frame + 2) {
-      return 0;
-    }
-    g_fault_watch.file_check_frame = g_fault_watch.frames;
     int fd = open("/data/local/tmp/rex_gpu_faults", O_RDONLY | O_CLOEXEC);
     if (fd < 0) {
       return 0;
     }
-    char text[32] = {};
+    char text[96] = {};
     ssize_t n = read(fd, text, sizeof(text) - 1);
     close(fd);
     if (n <= 0) {
       return 0;
     }
-    uint64_t total = std::strtoull(text, nullptr, 10);
-    uint64_t delta = total > g_fault_watch.file_count ? total - g_fault_watch.file_count : 0;
-    if (!g_fault_watch.file_count && total && !g_fault_watch.frames_seen_file) {
-      // Faults from before this run.
-      delta = 0;
+    // "<fault count> <timestamp of the last fault>" - any change is a new fault
+    // (the count alone stops changing once the kernel log buffer is full).
+    std::string current(text, size_t(n));
+    if (!g_fault_watch.frames_seen_file) {
+      g_fault_watch.frames_seen_file = true;
+      g_fault_watch.file_text = std::move(current);
+      return 0;
+    }
+    if (current == g_fault_watch.file_text) {
+      return 0;
     }
-    g_fault_watch.frames_seen_file = true;
-    g_fault_watch.file_count = total;
-    return uint32_t(delta);
+    uint64_t old_total = std::strtoull(g_fault_watch.file_text.c_str(), nullptr, 10);
+    uint64_t total = std::strtoull(current.c_str(), nullptr, 10);
+    g_fault_watch.file_text = std::move(current);
+    return uint32_t(std::max<uint64_t>(total > old_total ? total - old_total : 0, 1));
   }
   uint32_t count = 0;
   char record[2048];
@@ -2463,6 +2467,7 @@ void VulkanCommandProcessor::GpuFaultWatchDraw(uint64_t vs_hash, uint64_t ps_has
   uint64_t key = (vs_hash * 0x9E3779B97F4A7C15ull) ^ ps_hash ^ (uint64_t(flags) << 60);
   if (g_fault_watch.frame_keys.insert(key).second) {
     g_fault_watch.key_shaders.emplace(key, std::make_pair(vs_hash, ps_hash));
+    g_fault_watch.key_flags.emplace(key, flags);
   }
 }
 
@@ -2474,13 +2479,17 @@ void VulkanCommandProcessor::GpuFaultWatchFrameEnd() {
   }
   w.recent_frames.push_back(std::move(w.frame_keys));
   w.frame_keys = {};
-  while (w.recent_frames.size() > 8) {
+  while (w.recent_frames.size() > 12) {
     w.recent_frames.pop_front();
   }
   uint32_t new_faults = GpuFaultWatchReadFaults();
   if (new_faults) {
     w.faults += new_faults;
     ++w.fault_events;
+    if (w.fault_events <= 400) {
+      REXGPU_INFO("[gpu-fault] event {}: {} new faults at frame {}", w.fault_events, new_faults,
+                  w.frames);
+    }
     std::unordered_set<uint64_t> suspects;
     for (const auto& frame : w.recent_frames) {
       suspects.insert(frame.begin(), frame.end());
@@ -2503,7 +2512,7 @@ void VulkanCommandProcessor::GpuFaultWatchFrameEnd() {
       uint64_t key = ranking[i].second;
       auto shaders = w.key_shaders[key];
       REXGPU_INFO("[gpu-fault]   vs={:016X} ps={:016X} flags={:X} near_faults={} used_frames={}",
-                  shaders.first, shaders.second, uint32_t(key >> 60), w.fault_frames[key],
+                  shaders.first, shaders.second, w.key_flags[key], w.fault_frames[key],
                   w.used_frames[key]);
     }
   }
-- 
