index 0000000..3702673
--- /dev/null
+++ b/include/rex/trace_marker.h
@@ -0,0 +1,52 @@
+/**
+ * Systrace / Perfetto markers (Android ATrace) for timing analysis. No-ops
+ * elsewhere, and nearly free on Android while no trace is being recorded.
+ */
+#pragma once
+
+#include <rex/platform.h>
+
+#if REX_PLATFORM_ANDROID
+#include <android/trace.h>
+#endif
+
+namespace rex {
+
+class ScopedTraceMarker {
+ public:
+  explicit ScopedTraceMarker(const char* name) {
+#if REX_PLATFORM_ANDROID
+    active_ = ATrace_isEnabled();
+    if (active_) {
+      ATrace_beginSection(name);
+    }
+#else
+    (void)name;
+#endif
+  }
+  ~ScopedTraceMarker() {
+#if REX_PLATFORM_ANDROID
+    if (active_) {
+      ATrace_endSection();
+    }
+#endif
+  }
+  ScopedTraceMarker(const ScopedTraceMarker&) = delete;
+  ScopedTraceMarker& operator=(const ScopedTraceMarker&) = delete;
+
+ private:
+  bool active_ = false;
+};
+
+inline void TraceInstant(const char* name) {
+#if REX_PLATFORM_ANDROID
+  if (ATrace_isEnabled()) {
+    ATrace_beginSection(name);
+    ATrace_endSection();
+  }
+#else
+  (void)name;
+#endif
+}
+
+}  // namespace rex
