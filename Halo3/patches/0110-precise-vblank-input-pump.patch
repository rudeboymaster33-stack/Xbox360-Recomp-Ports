From 1362a299e67796d013cf7b83e53f48c7e21d630a Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Sat, 24 Oct 2026 15:47:46 -0400
Subject: [PATCH] gpu_vblank_precise: guest vblank on absolute deadlines with
 raised priority, [gpu-vblank] lateness log; SDL input pump at most every 4 ms

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01JJM25S15YdvewrFFwP8g6Z
---
 src/graphics/graphics_system.cpp   | 60 ++++++++++++++++++++++++++++++
 src/input/sdl/sdl_input_driver.cpp | 16 ++++++++
 2 files changed, 76 insertions(+)

diff --git a/src/graphics/graphics_system.cpp b/src/graphics/graphics_system.cpp
index 8f2fcb0..10049f5 100644
--- a/src/graphics/graphics_system.cpp
+++ b/src/graphics/graphics_system.cpp
@@ -12,6 +12,11 @@
 #include <rex/graphics/graphics_system.h>
 
 #include <algorithm>
+#if !defined(_WIN32)
+#include <cerrno>
+#include <ctime>
+#include <sys/resource.h>
+#endif
 #include <cctype>
 #include <cstdint>
 #include <functional>
@@ -31,6 +36,10 @@
 #include <rex/ui/window.h>
 #include <rex/ui/windowed_app_context.h>
 
+REXCVAR_DEFINE_BOOL(gpu_vblank_precise, true, "GPU",
+                    "Guest vblank timer sleeps until each vblank is due (absolute deadline, "
+                    "raised thread priority) instead of polling every 1 ms, and logs "
+                    "[gpu-vblank] lateness");
 REXCVAR_DEFINE_STRING(swap_post_effect, "none", "GPU", "Swap post effect: none, fxaa, fxaa_extreme")
     .allowed({"none", "fxaa", "fxaa_extreme"})
     .lifecycle(rex::cvar::Lifecycle::kRequiresRestart);
@@ -158,6 +167,57 @@ X_STATUS GraphicsSystem::SetupGuestGpu(runtime::FunctionDispatcher* function_dis
             std::max(uint64_t(1), uint64_t(double(guest_tick_frequency) / refresh_rate_hz));
         uint64_t no_vsync_interval_ticks = std::max(uint64_t(1), guest_tick_frequency / 1000);
         uint64_t last_frame_time = chrono::Clock::QueryGuestTickCount();
+#if !defined(_WIN32)
+        if (REXCVAR_GET(gpu_vblank_precise)) {
+          // Wake up for each vblank on time - a vblank delivered a few ms late
+          // can make the game miss its 30 fps swap slot (a 50 ms frame).
+          setpriority(PRIO_PROCESS, 0, -10);
+          const uint64_t interval_ns =
+              std::max(uint64_t(1000000), uint64_t(1e9 / refresh_rate_hz));
+          timespec now_ts;
+          clock_gettime(CLOCK_MONOTONIC, &now_ts);
+          uint64_t next_ns = uint64_t(now_ts.tv_sec) * 1000000000ull + uint64_t(now_ts.tv_nsec) +
+                             interval_ns;
+          uint32_t stat_count = 0, stat_late_1ms = 0, stat_late_4ms = 0;
+          uint64_t stat_max_late_ns = 0;
+          while (vsync_worker_running_) {
+            if (!REXCVAR_GET(vsync)) {
+              rex::thread::Sleep(std::chrono::milliseconds(1));
+              MarkVblank();
+              clock_gettime(CLOCK_MONOTONIC, &now_ts);
+              next_ns = uint64_t(now_ts.tv_sec) * 1000000000ull + uint64_t(now_ts.tv_nsec);
+              continue;
+            }
+            timespec deadline_ts;
+            deadline_ts.tv_sec = time_t(next_ns / 1000000000ull);
+            deadline_ts.tv_nsec = long(next_ns % 1000000000ull);
+            while (clock_nanosleep(CLOCK_MONOTONIC, TIMER_ABSTIME, &deadline_ts, nullptr) ==
+                   EINTR) {
+            }
+            clock_gettime(CLOCK_MONOTONIC, &now_ts);
+            uint64_t now_ns =
+                uint64_t(now_ts.tv_sec) * 1000000000ull + uint64_t(now_ts.tv_nsec);
+            uint64_t late_ns = now_ns > next_ns ? now_ns - next_ns : 0;
+            MarkVblank();
+            ++stat_count;
+            stat_late_1ms += late_ns > 1000000;
+            stat_late_4ms += late_ns > 4000000;
+            stat_max_late_ns = std::max(stat_max_late_ns, late_ns);
+            if (stat_count >= 600) {
+              REXGPU_INFO("[gpu-vblank] last 600: late >1 ms={} >4 ms={} max={:.2f} ms",
+                          stat_late_1ms, stat_late_4ms, double(stat_max_late_ns) * 1e-6);
+              stat_count = stat_late_1ms = stat_late_4ms = 0;
+              stat_max_late_ns = 0;
+            }
+            next_ns += interval_ns;
+            if (now_ns > next_ns + 4 * interval_ns) {
+              // Fell far behind (suspended) - restart the cadence.
+              next_ns = now_ns + interval_ns;
+            }
+          }
+          return 0;
+        }
+#endif
         while (vsync_worker_running_) {
           uint64_t current_time = chrono::Clock::QueryGuestTickCount();
           uint64_t interval_ticks =
diff --git a/src/input/sdl/sdl_input_driver.cpp b/src/input/sdl/sdl_input_driver.cpp
index c7c440d..f672740 100644
--- a/src/input/sdl/sdl_input_driver.cpp
+++ b/src/input/sdl/sdl_input_driver.cpp
@@ -9,6 +9,8 @@
  * @modified    Tom Clay, 2026 - Adapted for ReXGlue runtime
  */
 
+#include <atomic>
+#include <chrono>
 #include <array>
 #include <filesystem>
 
@@ -669,6 +671,20 @@ void SDLInputDriver::UpdateXCapabilities(ControllerState& state) {
 }
 
 void SDLInputDriver::QueueControllerUpdate() {
+  // The game polls input from several threads many times per frame - pumping
+  // SDL events (joystick updates, clock reads) for each poll kept the UI thread
+  // busy at ~60% of a core. Pump at most every 4 ms.
+  {
+    static std::atomic<int64_t> last_pump_ns{0};
+    int64_t now_ns = std::chrono::duration_cast<std::chrono::nanoseconds>(
+                         std::chrono::steady_clock::now().time_since_epoch())
+                         .count();
+    int64_t last_ns = last_pump_ns.load(std::memory_order_relaxed);
+    if (now_ns - last_ns < 4000000 ||
+        !last_pump_ns.compare_exchange_strong(last_ns, now_ns, std::memory_order_relaxed)) {
+      return;
+    }
+  }
   // Pump SDL events to ensure controller state is up to date.
   bool is_queued = false;
   sdl_pumpevents_queued_.compare_exchange_strong(is_queued, true);
